+import { expect, test } from "bun:test"
+import { Pipeline9RegionalFallbackSolver } from "lib/autorouter-pipelines/AutoroutingPipeline9_PreloadedTraceGraph/Pipeline9RegionalFallbackSolver"
+import type { HighDensityRoute } from "lib/types/high-density-types"
+import { getConnectivityMapFromSimpleRouteJson } from "lib/utils/getConnectivityMapFromSimpleRouteJson"
+import { copperPourReservationInput } from "./fixtures/copper-pour-reservations"
+
+test("regional candidate validation keeps outer wire constraints and native through-via plane antipads", (): void => {
+  const srj = copperPourReservationInput()
+  const route: HighDensityRoute = { connectionName: "DATA", traceThickness: 0.1, viaDiameter: 0.3,
+    route: [{ x: -3, y: 0, z: 0 }, { x: -2, y: 0, z: 0 }, { x: -2, y: 0, z: 3 },
+      { x: 2, y: 0, z: 3 }, { x: 2, y: 0, z: 0 }, { x: 3, y: 0, z: 0 }], vias: [{ x: -2, y: 0 }, { x: 2, y: 0 }] }
+  const parameters = { nodeWithPortPoints: { capacityMeshNodeId: "native-region", center: { x: 0, y: 0 }, width: 8, height: 8,
+      availableZ: [0, 3], allowedZByConnectionName: { DATA: [0, 3] },
+      portPoints: [{ x: -3, y: 0, z: 0, connectionName: "DATA" }, { x: 3, y: 0, z: 0, connectionName: "DATA" }] },
+    obstacles: srj.obstacles, boardObstacles: srj.obstacles, connMap: getConnectivityMapFromSimpleRouteJson(srj), colorMap: {},
+    layerCount: 4, allowBlindAndBuriedVias: false, viaDiameter: 0.3, traceWidth: 0.1,
+    viaToPadClearance: 0.1, obstacleMargin: 0.1, effort: 1, movablePreloadedConnectionNames: new Set(["DATA"]) }
+  const original = JSON.stringify({ srj, route })
+  const solver = new Pipeline9RegionalFallbackSolver(parameters)
+  const validator = solver.highDensitySolver.growShrinkSolutionValidator!
+  expect(validator).toBeDefined()
+  expect(validator([route])).toBe(true)
+  const inner = { ...route, route: route.route.map((point) => ({ ...point, z: point.z === 3 ? 1 : point.z })) }
+  expect(validator([inner])).toBe(false)
+  expect(solver.stats.layerDomainCandidateRejectionCount).toBe(1)
+  const blocked = new Pipeline9RegionalFallbackSolver({ ...parameters,
+    boardObstacles: [...srj.obstacles, { type: "rect", center: { x: -2, y: 0 }, width: 0.2, height: 0.2, layers: ["inner2"], connectedTo: ["foreign_pad"] }] })
+  expect(blocked.highDensitySolver.growShrinkSolutionValidator!([route])).toBe(false)
+  expect(blocked.stats.preloadedViaCandidateRejectionCount).toBe(1)
+  expect(JSON.stringify({ srj, route })).toBe(original)
+})
diff --git a/tests/portfolio-same-root-bridge-wire-domain.test.ts b/tests/portfolio-same-root-bridge-wire-domain.test.ts
new file mode 100644
index 00000000..dfe54ae1
--- /dev/null
+++ b/tests/portfolio-same-root-bridge-wire-domain.test.ts
@@ -0,0 +1,41 @@
+import { expect, test } from "bun:test"
+import { PortfolioSingleIntraNodeSolver } from "lib/solvers/HyperHighDensitySolver/PortfolioSingleIntraNodeSolver"
+import { repairDisconnectedSameRootPortPoints } from "lib/solvers/HyperHighDensitySolver/repairDisconnectedSameRootPortPoints"
+import type { HighDensityIntraNodeRoute, NodeWithPortPoints } from "lib/types/high-density-types"
+
+test("a same-root bridge cannot grant its broader wire domain to another connection", (): void => {
+  const node: NodeWithPortPoints = {
+    capacityMeshNodeId: "same-root-wire-domains", center: { x: 0, y: 0 }, width: 6, height: 6,
+    availableZ: [0, 3], allowedZByConnectionName: { DATA: [0], AUX: [0, 3] },
+    portPoints: ["DATA", "AUX"].flatMap((connectionName) => [
+      { connectionName, rootConnectionName: "ROOT", x: -1, y: 0, z: 0 },
+      { connectionName, rootConnectionName: "ROOT", x: 1, y: 0, z: 0 },
+    ]),
+  }
+  const routes: HighDensityIntraNodeRoute[] = [
+    { connectionName: "DATA", rootConnectionName: "ROOT", traceThickness: 0.1, viaDiameter: 0.3,
+      route: [{ x: -1, y: 0, z: 0 }], vias: [] },
+    { connectionName: "AUX", rootConnectionName: "ROOT", traceThickness: 0.1, viaDiameter: 0.3,
+      route: [{ x: -1, y: 0, z: 0 }, { x: -1, y: 0, z: 3 },
+        { x: 1, y: 0, z: 3 }, { x: 1, y: 0, z: 0 }],
+      vias: [{ x: -1, y: 0 }, { x: 1, y: 0 }] },
+  ]
+  expect(routes.every((route) => route.route.every((point) =>
+    node.allowedZByConnectionName![route.connectionName]!.includes(point.z)))).toBe(true)
+  expect(repairDisconnectedSameRootPortPoints(routes, node).some((route) =>
+    route.connectionName === "DATA" && route.route.some((point) => point.z === 3))).toBe(true)
+  const solver = new PortfolioSingleIntraNodeSolver({
+    nodeWithPortPoints: node, layerCount: 4, traceWidth: 0.1,
+    viaDiameter: 0.3, obstacleMargin: 0.1, effort: 0.1,
+  })
+  const candidate = { solvedRoutes: routes, solved: true, failed: false, error: null }
+  solver.solved = true
+  solver.winningSolver = candidate as never
+  solver.onSolve({ solver: candidate } as never)
+  expect(candidate.solved).toBe(false)
+  expect(candidate.failed).toBe(true)
+  expect(candidate.error).toBe('Candidate uses a forbidden wire layer for "DATA"')
+  expect(solver.solved).toBe(false)
+  expect(solver.winningSolver).toBeUndefined()
+  expect(solver.solvedRoutes).toEqual([])
+})
