@@ -0,0 +1,63 @@
+import copy
+import difflib
+import gzip
+import hashlib
+import io
+import json
+import pathlib
+import tarfile
+
+root = pathlib.Path(__file__).resolve().parent
+originals = json.loads((root / 'provenance.json').read_text())
+lookup = {item['label']: item for item in originals}
+repair04 = json.loads((root / 'packaging-provenance.json').read_text())
+inputs = [('repair03-direct', lookup['repair03-direct']), ('repair04-build-source', repair04)]
+records = []
+old = b'  override getConstructorParams() {'
+new = b'  override getConstructorParams(): readonly [GlobalDrcBranchPortfolioSolverParams] {'
+for label, metadata in inputs:
+    archive = (root / pathlib.Path(metadata['path']).name).read_bytes()
+    if hashlib.sha256(archive).hexdigest() != metadata['sha256']:
+        raise RuntimeError(f'Original source archive hash differs: {label}')
+    source = tarfile.open(fileobj=io.BytesIO(archive), mode='r:gz')
+    output = io.BytesIO()
+    patches = []
+    changed_files = []
+    with tarfile.open(fileobj=output, mode='w', format=tarfile.PAX_FORMAT) as target:
+        for original in source.getmembers():
+            member = copy.copy(original)
+            data = source.extractfile(original).read() if member.isfile() else None
+            changed = data
+            if member.isfile() and member.name.endswith('/solvers/GlobalDrcForceImproveSolver/GlobalDrcBranchPortfolioSolver.ts'):
+                if data.count(old) != 1:
+                    raise RuntimeError(f'Unexpected constructor method in {member.name}')
+                changed = data.replace(old, new)
+                filename = member.name.removeprefix('package/')
+                changed_files.append(filename)
+                patches.append(''.join(difflib.unified_diff(data.decode().splitlines(keepends=True), changed.decode().splitlines(keepends=True), fromfile='a/' + filename, tofile='b/' + filename)))
+                member.size = len(changed)
+            target.addfile(member, io.BytesIO(changed) if changed is not None else None)
+    if len(changed_files) != 1:
+        raise RuntimeError(f'Expected one declaration annotation in {label}, found {len(changed_files)}')
+    patch = ''.join(patches)
+    patch_name = label + '-declaration-packaging.patch'
+    (root / patch_name).write_text(patch)
+    data = gzip.compress(output.getvalue(), mtime=0)
+    sha = hashlib.sha256(data).hexdigest()
+    filename = ('repair03-direct-b62b158e-build-' if label == 'repair03-direct' else 'repair04-4f9d8bd6-declarations-') + sha[:8] + '.tgz'
+    (root / filename).write_bytes(data)
+    records.append({
+        'label': label + '-declarations',
+        'inputArchive': pathlib.Path(metadata['path']).name,
+        'inputArchiveSha256': metadata['sha256'],
+        'sourceCommit': metadata.get('commit', metadata.get('sourceCommit')),
+        'patch': patch_name,
+        'patchSha256': hashlib.sha256(patch.encode()).hexdigest(),
+        'path': filename,
+        'sha256': sha,
+        'bytes': len(data),
+        'changedFiles': changed_files,
+        'change': 'Explicit readonly tuple constructor parameter return annotation; method body and runtime behavior unchanged',
+    })
+(root / 'declaration-packaging-provenance.json').write_text(json.dumps(records, indent=2) + '\n')
+print(json.dumps(records, indent=2))
