++import { expect, test } from "bun:test"
++import { findClearancePath, FindClearancePathSolver, extractRepairRegion, getFixedObstacleViolations, getNewViaPadViolations } from "../lib"
++import type { HighDensityRoute, SimpleRouteJson } from "high-density-repair03/lib"
++
++test("native four-layer repair uses only outer signal wire and permits full-span via plane antipads", (): void => {
++  const srj: SimpleRouteJson = {
++    layerCount: 4, minTraceWidth: 0.1, allowedLayers: ["top", "bottom"],
++    bounds: { minX: -6, maxX: 6, minY: -6, maxY: 6 },
++    connections: [{ name: "DATA", allowedLayers: ["top", "bottom"], pointsToConnect: [] }],
++    obstacles: [
++      { type: "rect", center: { x: 0, y: 0 }, width: 0.4, height: 16, layers: ["top"], connectedTo: ["foreign"] },
++      ...["inner1", "inner2"].map((layer): SimpleRouteJson["obstacles"][number] => ({ type: "rect", center: { x: 0, y: 0 }, width: 12, height: 12, layers: [layer], connectedTo: ["GND"], isCopperPour: true })),
++    ],
++  }
++  const route: HighDensityRoute = { connectionName: "DATA", traceThickness: 0.1, viaDiameter: 0.3,
++    route: [{ x: -2, y: 0, z: 0 }, { x: 2, y: 0, z: 0 }], vias: [] }
++  const original = JSON.stringify({ srj, route })
++  const input = { srj, routes: [route], routeIndex: 0, start: route.route[0]!, end: route.route[1]!, bounds: srj.bounds,
++    traceThickness: 0.1, traceClearance: 0.1, viaClearance: 0.1, viaHoleDiameter: 0.15, maxNodes: 20_000 }
++  const synchronous = findClearancePath(input)
++  const solver = new FindClearancePathSolver(input)
++  solver.solve()
++  for (const path of [synchronous, solver.getOutput()]) {
++    expect(path).not.toBeNull()
++    expect([...new Set(path!.map((point): number => point.z))].sort()).toEqual([0, 3])
++    const vias = path!.flatMap((point, index): { x: number; y: number }[] => index > 0 && point.z !== path![index - 1]!.z ? [{ x: point.x, y: point.y }] : [])
++    const result = { ...route, route: path!, vias }
++    expect(vias).toHaveLength(2)
++    expect(getFixedObstacleViolations({ srj, routes: [result] })).toEqual([])
++    expect(getNewViaPadViolations({ srj, previousRoutes: [route], routes: [result] })).toEqual([])
++    const inner = { ...result, route: result.route.map((point) => ({ ...point, z: point.z === 3 ? 1 : point.z })) }
++    expect(getFixedObstacleViolations({ srj, routes: [inner] }).some((violation): boolean => violation.kind === "wire")).toBe(true)
++    const blockedSrj = { ...srj, obstacles: [...srj.obstacles, { type: "rect" as const, center: vias[0]!, width: 0.2, height: 0.2, layers: ["inner1"], connectedTo: ["foreign_pad"] }] }
++    expect(getNewViaPadViolations({ srj: blockedSrj, previousRoutes: [route], routes: [result] }).length).toBeGreaterThan(0)
++  }
++  const regional = extractRepairRegion({ srj, routes: [route], bounds: srj.bounds })
++  expect(regional.srj.layerCount).toBe(4)
++  expect(regional.srj.allowedLayers).toEqual(["top", "bottom"])
++  expect(regional.srj.connections[0]!.allowedLayers).toEqual(["top", "bottom"])
++  expect(JSON.stringify({ srj, route })).toBe(original)
++})
