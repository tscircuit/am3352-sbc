+new file mode 100644
+index 0000000..fa4c2fa
+--- /dev/null
++++ b/tests/native-wire-layer-domains.test.ts
+@@ -0,0 +1,49 @@
++import { expect, test } from "bun:test"
++import { TinyHyperGraphSolver, type TinyHyperGraphProblem, type TinyHyperGraphTopology } from "lib/core"
++import { convertToSerializedHyperGraph } from "lib/compat/convertToSerializedHyperGraph"
++import { loadSerializedHyperGraph } from "lib/compat/loadSerializedHyperGraph"
++import { TinyHyperGraphSectionSolver } from "lib/section-solver"
++
++test("route domains preserve physical z0 and z3 through solving, replay and negative reachability", (): void => {
++  const topology: TinyHyperGraphTopology = {
++    portCount: 4, regionCount: 4,
++    regionIncidentPorts: [[0], [0, 1, 2], [1, 2, 3], [3]],
++    incidentPortRegion: [[1, 0], [1, 2], [1, 2], [2, 3]],
++    regionWidth: new Float64Array([1, 4, 4, 1]), regionHeight: new Float64Array([1, 4, 4, 1]),
++    regionCenterX: new Float64Array([0, 1, 3, 4]), regionCenterY: new Float64Array(4),
++    portAngleForRegion1: new Int32Array(4), portAngleForRegion2: new Int32Array(4),
++    portX: new Float64Array([0, 2, 2, 4]), portY: new Float64Array([0, 0, 1, 0]),
++    portZ: new Int32Array([0, 1, 3, 0]),
++  }
++  for (const innerOrBottom of [3, 1]) {
++    const problem: TinyHyperGraphProblem = {
++      routeCount: 1, routeAllowedZ: [[0, innerOrBottom]],
++      portSectionMask: new Int8Array([1, 1, 1, 1]), routeStartPort: new Int32Array([0]),
++      routeEndPort: new Int32Array([3]), routeNet: new Int32Array([0]), regionNetId: new Int32Array([-1, -1, -1, -1]),
++    }
++    const solver = new TinyHyperGraphSolver(topology, problem)
++    solver.solve()
++    expect(solver.failed).toBe(false)
++    expect(solver.solved).toBe(true)
++    const usedPorts = solver.state.regionSegments.flatMap((segments) => segments.flatMap((segment) => segment.slice(1)))
++    expect(usedPorts.map((port) => topology.portZ[port])).toContain(innerOrBottom)
++    expect(usedPorts.every((port) => [0, innerOrBottom].includes(topology.portZ[port]))).toBe(true)
++    const serialized = convertToSerializedHyperGraph(solver)
++    const replay = loadSerializedHyperGraph(serialized)
++    expect(replay.problem.routeAllowedZ).toEqual([[0, innerOrBottom]])
++    expect(() => loadSerializedHyperGraph({ ...serialized,
++      connections: serialized.connections!.map((connection) => ({ ...connection, allowedZ: [0] })),
++    })).toThrow("forbidden physical wire layer")
++    const rerouted = new TinyHyperGraphSolver(replay.topology, replay.problem)
++    rerouted.solve()
++    expect(rerouted.solved).toBe(true)
++    const section = new TinyHyperGraphSectionSolver(replay.topology, replay.problem, replay.solution)
++    section.solve()
++    expect(section.solved).toBe(true)
++    expect(section.getSolvedSolver().problem.routeAllowedZ).toEqual([[0, innerOrBottom]])
++    const impossible = new TinyHyperGraphSolver(topology, { ...problem, routeAllowedZ: [[0]] })
++    impossible.solve()
++    expect(impossible.failed).toBe(true)
++    expect(impossible.solved).toBe(false)
++  }
++})
