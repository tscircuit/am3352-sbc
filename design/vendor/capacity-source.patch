@@ -0,0 +1,28 @@
+import { expect, test } from "bun:test"
+import { PortfolioSingleIntraNodeSolver } from "lib/solvers/HyperHighDensitySolver/PortfolioSingleIntraNodeSolver"
+import type { NodeWithPortPoints } from "lib/types/high-density-types"
+
+test("detailed routing preserves separate physical wire domains for crossing connections", (): void => {
+  const node: NodeWithPortPoints = {
+    capacityMeshNodeId: "native-mixed-domains", center: { x: 0, y: 0 }, width: 6, height: 6,
+    availableZ: [0, 1, 2, 3], allowedZByConnectionName: { DATA: [0, 3], OTHER: [0, 1] },
+    portPoints: [
+      { connectionName: "DATA", x: -2, y: -2, z: 0 }, { connectionName: "DATA", x: 2, y: 2, z: 0 },
+      { connectionName: "OTHER", x: -2, y: 2, z: 0 }, { connectionName: "OTHER", x: 2, y: -2, z: 0 },
+    ],
+  }
+  const solver = new PortfolioSingleIntraNodeSolver({
+    nodeWithPortPoints: node, layerCount: 4, traceWidth: 0.1, viaDiameter: 0.3,
+    obstacleMargin: 0.1, effort: 0.1, enableNegotiatedSearch: true, captureSearchDebug: false,
+  })
+  solver.solve()
+  expect(solver.failed).toBe(false)
+  expect(solver.solved).toBe(true)
+  expect(solver.solvedRoutes).toHaveLength(2)
+  for (const route of solver.solvedRoutes) {
+    const domain = node.allowedZByConnectionName![route.connectionName]!
+    expect(route.route.every((point) => domain.includes(point.z))).toBe(true)
+    expect(route.route.some((point) => point.z === 2)).toBe(false)
+  }
+  expect(solver.solvedRoutes.flatMap((route) => route.vias).length).toBeGreaterThan(0)
+})
diff --git a/tests/native-allowed-wire-layer-domains.test.ts b/tests/native-allowed-wire-layer-domains.test.ts
new file mode 100644
index 00000000..3bbd4442
--- /dev/null
+++ b/tests/native-allowed-wire-layer-domains.test.ts
@@ -0,0 +1,40 @@
+import { expect, test } from "bun:test"
+import type { SimpleRouteJson } from "lib/types"
+import { createAllowedZResolver, getAllowedZForConnection } from "lib/utils/getAllowedZForConnection"
+import { mergeConnections } from "lib/solvers/NetToPointPairsSolver/mergeConnections"
+
+test("native wire domains intersect board, connection, bus and immutable foreign plane ownership", (): void => {
+  const srj: SimpleRouteJson = {
+    layerCount: 4, minTraceWidth: 0.1,
+    bounds: { minX: -6, maxX: 6, minY: -6, maxY: 6 },
+    outline: [{ x: -5, y: -5 }, { x: 5, y: -5 }, { x: 5, y: 5 }, { x: -5, y: 5 }],
+    obstacles: ["inner1", "inner2"].map((layer) => ({
+      type: "rect", layers: [layer], center: { x: 0, y: 0 }, width: 10, height: 10,
+      isCopperPour: true, connectedTo: ["native_ground_source"],
+    })),
+    connections: [
+      { name: "DATA", source_trace_id: "native_data_source", pointsToConnect: [{ x: -3, y: 0, layer: "top" }, { x: 3, y: 0, layer: "top" }] },
+      { name: "GROUND", source_trace_id: "native_ground_source", pointsToConnect: [{ x: -2, y: 2, layer: "top" }, { x: 2, y: 2, layer: "inner1" }] },
+    ],
+  }
+  const original = JSON.stringify(srj)
+  const resolve = createAllowedZResolver(srj)
+  expect(resolve("DATA")).toEqual([0, 3])
+  expect(resolve("GROUND")).toEqual([0, 1, 2, 3])
+  const merged = mergeConnections([srj.connections[1]!, {
+    name: "GROUND_PART", pointsToConnect: [srj.connections[1]!.pointsToConnect[0]!, { x: 1, y: 2, layer: "top" }],
+  }])
+  expect(merged).toHaveLength(1)
+  expect(getAllowedZForConnection({ ...srj, connections: merged }, merged[0]!.name)).toEqual([0, 1, 2, 3])
+  const domain = resolve("DATA")
+  domain.push(1)
+  expect(resolve("DATA")).toEqual([0, 3])
+  expect(getAllowedZForConnection({ ...srj, allowedLayers: ["top", "bottom"],
+    connections: srj.connections.map((connection) => connection.name === "DATA" ? { ...connection, allowedLayers: ["inner1", "bottom"] } : connection),
+    buses: [{ busId: "DATA_BUS", connectionNames: ["DATA"], allowedLayers: ["top", "bottom"] }],
+  }, "DATA")).toEqual([3])
+  expect(() => getAllowedZForConnection({ ...srj, allowedLayers: ["inner1"] }, "DATA")).toThrow("no legal wire layers")
+  expect(() => getAllowedZForConnection({ ...srj, allowedLayers: ["inner3"] }, "GROUND")).toThrow("Invalid allowed routing layer")
+  expect(() => getAllowedZForConnection({ ...srj, allowedLayers: [] }, "GROUND")).toThrow("no legal wire layers")
+  expect(JSON.stringify(srj)).toBe(original)
+})
