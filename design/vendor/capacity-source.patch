+const fs = require('fs');
+const path = require('path');
+const sourceRoot = fs.realpathSync(path.resolve(process.argv[2] || '.'));
+const scratch = path.resolve(process.argv[3] || path.join(sourceRoot, 'work', 'standalone-declarations'));
+const ts = require(path.join(sourceRoot, 'node_modules', 'typescript'));
+const configPath = path.join(sourceRoot, 'tsconfig.json');
+const stage = path.join(scratch, 'declaration-stage');
+const originalEntry = path.join(sourceRoot, 'lib', 'index.ts');
+fs.mkdirSync(scratch, { recursive: true });
+const read = ts.readConfigFile(configPath, ts.sys.readFile);
+const parsed = ts.parseJsonConfigFileContent(read.config, ts.sys, path.dirname(configPath));
+const options = { ...parsed.options, paths: { ...parsed.options.paths, '@tscircuit/capacity-autorouter':[originalEntry] }, resolveJsonModule:true, types:['bun'], typeRoots:[path.join(sourceRoot,'node_modules','@types')], noEmit: false, declaration: true, emitDeclarationOnly: true, noCheck:true, declarationMap: false, rootDir: sourceRoot, outDir: stage };
+const ambientRoots=parsed.fileNames.filter(filename=>filename.endsWith('.d.ts')&&!/(?:fixture|dataset)/i.test(path.basename(filename)));
+const compilerHost=ts.createCompilerHost(options);
+const sourceFileCache=new Map();
+const readSourceFile=compilerHost.getSourceFile.bind(compilerHost);
+compilerHost.getSourceFile=(filename,languageVersion,onError,shouldCreateNewSourceFile)=>{
+  if(!sourceFileCache.has(filename))sourceFileCache.set(filename,readSourceFile(filename,languageVersion,onError,shouldCreateNewSourceFile));
+  return sourceFileCache.get(filename);
+};
+const initial = ts.createProgram([originalEntry, ...ambientRoots], options, compilerHost);
+const roots = initial.getSourceFiles().filter(f => !f.isDeclarationFile && !f.fileName.endsWith('.json')).map(f => f.fileName);
+const program = ts.createProgram([originalEntry, ...ambientRoots, ...roots], options, compilerHost, initial);
+const diagnostics = ts.getPreEmitDiagnostics(program);
+if (diagnostics.length) throw new Error(ts.formatDiagnosticsWithColorAndContext(diagnostics, { getCanonicalFileName:f=>f, getCurrentDirectory:()=>sourceRoot, getNewLine:()=> '\n' }));
+fs.rmSync(stage, { recursive: true, force: true });
+fs.mkdirSync(stage, { recursive: true });
+const originalForStaged = new Map();
+const declarationRegenerations = [];
+const regenerateRuntimeDeclaration = source => {
+  const virtualPath=source.fileName.replace(/\.d\.ts$/,'.declaration-source.ts');
+  const host=ts.createCompilerHost(options);
+  const normalGetSourceFile=host.getSourceFile.bind(host);
+  const normalFileExists=host.fileExists.bind(host);
+  const normalReadFile=host.readFile.bind(host);
+  host.fileExists=filename=>filename===virtualPath||normalFileExists(filename);
+  host.readFile=filename=>filename===virtualPath?source.text:normalReadFile(filename);
+  host.getSourceFile=(filename,languageVersion,onError,shouldCreateNewSourceFile)=>filename===virtualPath?ts.createSourceFile(filename,source.text,languageVersion,true):normalGetSourceFile(filename,languageVersion,onError,shouldCreateNewSourceFile);
+  const declarationProgram=ts.createProgram([virtualPath],options,host);
+  let regenerated;
+  const emit=declarationProgram.emit(declarationProgram.getSourceFile(virtualPath),(filename,text)=>{if(filename.endsWith('.d.ts'))regenerated=text;});
+  if(emit.emitSkipped||emit.diagnostics.length||!regenerated)throw new Error(`Runtime declaration regeneration failed: ${source.fileName}`);
+  const crypto=require('crypto');
+  declarationRegenerations.push({source:path.relative(sourceRoot,source.fileName),originalSha256:crypto.createHash('sha256').update(source.text).digest('hex'),regeneratedSha256:crypto.createHash('sha256').update(regenerated).digest('hex')});
+  return regenerated;
+};
+const stagePath = original => {
+  const relative = path.relative(sourceRoot, original);
+  if (relative.startsWith('..') || path.isAbsolute(relative)) throw new Error(`Unmapped source outside source root: ${original}`);
+  return path.join(stage, relative).replace(/(?<!\.d)\.(tsx?|mts|cts)$/, '.d.ts');
+};
+for (const original of roots) {
+  const source = program.getSourceFile(original);
+  const emit = program.emit(source, (filename, data, bom, onError, sourceFiles) => {
+    fs.mkdirSync(path.dirname(filename), { recursive: true });
+    fs.writeFileSync(filename, data);
+    if (sourceFiles && sourceFiles.length === 1) originalForStaged.set(filename, sourceFiles[0].fileName);
+  });
+  if (emit.emitSkipped || emit.diagnostics.length) throw new Error(`Declaration emit failed for ${original}: ${emit.emitSkipped}, ${emit.diagnostics.length}`);
+}
+for (const source of program.getSourceFiles()) {
+  if (!source.isDeclarationFile && !source.fileName.endsWith('.json')) continue;
+  const filename = stagePath(source.fileName);
+  fs.mkdirSync(path.dirname(filename), { recursive: true });
+  const hasRuntimeInitializer=source.isDeclarationFile&&source.statements.some(statement=>ts.isVariableStatement(statement)&&statement.declarationList.declarations.some(declaration=>declaration.initializer));
+  fs.writeFileSync(filename, hasRuntimeInitializer?regenerateRuntimeDeclaration(source):source.text);
+  if (source.isDeclarationFile) originalForStaged.set(filename, source.fileName);
+}
+const stagedForOriginal = new Map();
+for (const [filename, original] of originalForStaged) {
+  stagedForOriginal.set(original, filename);
+  stagedForOriginal.set(fs.realpathSync(original), filename);
+}
+const redirectOriginal = new Map();
+for (const [target, aliases] of program.redirectTargetsMap) {
+  for (const alias of aliases) {
+    redirectOriginal.set(alias, target);
+    redirectOriginal.set(fs.realpathSync(alias), target);
+  }
+}
+const preservedPaths = { '@tscircuit/capacity-autorouter':[stagePath(originalEntry)] };
+const {getLibraryName}=require(path.join(sourceRoot, 'node_modules/dts-bundle-generator/dist/helpers/node-modules'));
+const inlinedLibraries=[...new Set(program.getSourceFiles().map(f=>getLibraryName(f.fileName)).filter(n=>n && n !== 'typescript' && n !== 'bun-types' && n !== '@types/bun' && n !== '@types/node'))];
+const publicTypeBoundaryNames=new Set(['circuit-json','zod','@tscircuit/core','transformation-matrix']);
+const publicDependencies={};
+const publicBoundaryExports=new Map();
+const preservePublicBoundary=name=>{
+  if(!publicTypeBoundaryNames.has(name))return undefined;
+  if(!publicDependencies[name])publicDependencies[name]=JSON.parse(fs.readFileSync(path.join(sourceRoot,'node_modules',name,'package.json'),'utf8')).version;
+  return name;
+};
+const publicBoundaryForSpecifier=specifier=>[...publicTypeBoundaryNames].find(name=>specifier===name||specifier.startsWith(name+'/'));
+const duplicateGlobalDeclarations = [];
+const stagedSource = filename => program.getSourceFile(originalForStaged.get(filename));
+const checker=program.getTypeChecker();
+const printer=ts.createPrinter();
+let narrowedStatements=0;
+const declarationTarget = original => {
+  const real=fs.realpathSync(original);
+  const canonical=redirectOriginal.get(original)||redirectOriginal.get(real)||real;
