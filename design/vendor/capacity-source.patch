@@ -0,0 +1,88 @@
+import copy
+import difflib
+import gzip
+import hashlib
+import io
+import json
+import pathlib
+import posixpath
+import tarfile
+
+root = pathlib.Path(__file__).resolve().parent
+manifest = json.loads((root / 'provenance.json').read_text())
+lookup = {item['label']: item for item in manifest}
+original = (root / pathlib.Path(lookup['repair04']['path']).name).read_bytes()
+compatible = (root / pathlib.Path(lookup['repair03-compatible']['path']).name).read_bytes()
+if hashlib.sha256(original).hexdigest() != lookup['repair04']['sha256']:
+    raise RuntimeError('repair04 exact source archive hash differs')
+if hashlib.sha256(compatible).hexdigest() != lookup['repair03-compatible']['sha256']:
+    raise RuntimeError('compatible repair03 exact source archive hash differs')
+source = tarfile.open(fileobj=io.BytesIO(original), mode='r:gz')
+nested = tarfile.open(fileobj=io.BytesIO(compatible), mode='r:gz')
+package_member = source.getmember('package/package.json')
+package_text = source.extractfile(package_member).read().decode()
+package = json.loads(package_text)
+nested_package = json.loads(nested.extractfile('package/package.json').read())
+del package['dependencies']['high-density-repair03']
+for name, requirement in nested_package['dependencies'].items():
+    if name in package['dependencies'] and package['dependencies'][name] != requirement:
+        raise RuntimeError(f'Conflicting runtime dependency: {name}')
+    package['dependencies'][name] = requirement
+package['files'].append('vendor/high-density-repair03')
+patched_package = json.dumps(package, indent=2) + '\n'
+patches = []
+changed_files = []
+output = io.BytesIO()
+with tarfile.open(fileobj=output, mode='w', format=tarfile.PAX_FORMAT) as target:
+    for original_member in source.getmembers():
+        member = copy.copy(original_member)
+        data = source.extractfile(original_member).read() if member.isfile() else None
+        if member.name == 'package/package.json':
+            changed = patched_package.encode()
+        elif member.isfile() and member.name.startswith('package/lib/') and member.name.endswith('.ts'):
+            relative = posixpath.relpath('package/vendor/high-density-repair03/lib', posixpath.dirname(member.name))
+            if not relative.startswith('.'):
+                relative = './' + relative
+            changed = data.replace(b'"high-density-repair03/lib"', ('"' + relative + '"').encode())
+        else:
+            changed = data
+        if changed != data:
+            filename = member.name.removeprefix('package/')
+            patches.append(''.join(difflib.unified_diff(data.decode().splitlines(keepends=True), changed.decode().splitlines(keepends=True), fromfile='a/' + filename, tofile='b/' + filename)))
+            changed_files.append(filename)
+            member.size = len(changed)
+        target.addfile(member, io.BytesIO(changed) if changed is not None else None)
+    directory = tarfile.TarInfo('package/vendor')
+    directory.type = tarfile.DIRTYPE
+    directory.mode = 0o755
+    directory.mtime = package_member.mtime
+    target.addfile(directory)
+    for original_member in nested.getmembers():
+        member = copy.copy(original_member)
+        member.name = member.name.replace('package', 'package/vendor/high-density-repair03', 1)
+        target.addfile(member, nested.extractfile(original_member) if member.isfile() else None)
+patch = ''.join(patches)
+(root / 'repair04-source-packaging.patch').write_text(patch)
+data = gzip.compress(output.getvalue(), mtime=0)
+filename = f'repair04-4f9d8bd6-build-{hashlib.sha256(data).hexdigest()[:8]}.tgz'
+(root / filename).write_bytes(data)
+metadata = {
+    'label': 'repair04-build-source',
+    'sourceCommit': lookup['repair04']['commit'],
+    'sourceArchiveSha256': lookup['repair04']['sha256'],
+    'nestedCompatibleCommit': lookup['repair03-compatible']['commit'],
+    'nestedCompatibleArchiveSha256': hashlib.sha256(compatible).hexdigest(),
+    'patches': [{'file': 'repair04-source-packaging.patch', 'sha256': hashlib.sha256(patch.encode()).hexdigest()}],
+    'path': filename,
+    'sha256': hashlib.sha256(data).hexdigest(),
+    'bytes': len(data),
+    'changedFiles': changed_files,
+    'changes': [
+        'repair04 embeds exact compatible03 source under vendor/high-density-repair03',
+        'repair04 module specifiers reference package-relative compatible03 source',
+        'repair04 declares compatible03 public runtime dependencies directly',
+        'all embedded compatible03 source bytes remain identical to the exact Git archive',
+    ],
+}
+(root / 'packaging-provenance.json').write_text(json.dumps(metadata, indent=2) + '\n')
+print(json.dumps(metadata, indent=2))
