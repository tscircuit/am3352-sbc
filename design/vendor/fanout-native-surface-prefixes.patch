+import { test, expect } from "bun:test"
+import { getSvgFromGraphicsObject } from "graphics-debug"
+import { trimOwnedEgressBacktracks } from "../lib/trim-owned-egress-backtracks"
+test("an owned source connector retrace is clipped before its corner is chamfered", () => {
+  const points = [{ x: 0, y: 0 }, { x: .2, y: .2 }, { x: .5, y: .2 }, { x: .4, y: .2 }, { x: .4 + 1e-16, y: .2 }, { x: .4, y: -.2 }]
+  const original = structuredClone(points), trimmed = trimOwnedEgressBacktracks(points)
+  expect(trimmed).toEqual([points[0]!, points[1]!, points[3]!, points[5]!])
+  expect(points).toEqual(original)
+  expect(trimmed[0]).toEqual(points[0])
+  expect(trimmed.at(-1)).toEqual(points.at(-1))
+  expect(trimOwnedEgressBacktracks([{ x: 0, y: 0 }, { x: 1, y: 0 }, { x: 1, y: 1 }])).toEqual([{ x: 0, y: 0 }, { x: 1, y: 0 }, { x: 1, y: 1 }])
+  expect(getSvgFromGraphicsObject({ title: "Owned egress keeps a single continuous path before chamfering", lines: [{ points: points, strokeColor: "#ef4444", strokeWidth: .06 }, { points: trimmed, strokeColor: "#15803d", strokeWidth: .02 }], points: trimmed.map(point => ({ ...point })) })).toMatchSnapshot()
+})
