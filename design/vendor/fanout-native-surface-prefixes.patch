+    const plans = folded && normalizeFreshSourceCorners({ inputSrj: srj, plans: folded, clearance, immutableTraceIds: new Set(heldMandatoryPlans.map(plan => plan.trace.pcb_trace_id)) })
+    if (heldMandatoryPlans.some(held => !plans?.some(plan => plan.connectionIndex === held.connectionIndex && JSON.stringify(plan.trace) === JSON.stringify(held.trace)))) return null
