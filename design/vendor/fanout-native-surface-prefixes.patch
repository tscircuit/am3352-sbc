index 0000000..ce74cad
--- /dev/null
+++ b/lib/normalize-fresh-source-corners.ts
@@ -0,0 +1,93 @@
+import type { SimpleRouteJson } from "@tscircuit/capacity-autorouter"
+import { changedFanoutCopperIsSelfClear } from "./normalize-fanout-plan-corners"
+import { getSourcePadReentries } from "./source-pad-reentry"
+import { validateRoutedCopperDrc } from "./validate-routed-copper-drc"
+import type { FanoutRoutePlan, FanoutRoutePoint, RoutedSegment } from "./types"
+
+const EPSILON = 1e-9
+const distance = (a: { x: number; y: number }, b: { x: number; y: number }): number => Math.hypot(a.x - b.x, a.y - b.y)
+const hasPortAnchor = (point: FanoutRoutePoint): boolean =>
+  "start_pcb_port_id" in point && !!point.start_pcb_port_id ||
+  "end_pcb_port_id" in point && !!point.end_pcb_port_id ||
+  "pcb_port_id" in point && !!point.pcb_port_id ||
+  "pointId" in point && !!point.pointId
+
+function routeSegments(route: readonly FanoutRoutePoint[]): RoutedSegment[] {
+  return route.slice(1).flatMap((point, index) => {
+    const previous = route[index]!
+    return point.route_type === "wire" && previous.route_type === "wire" && point.layer === previous.layer && distance(point, previous) > EPSILON
+      ? [{ start: { x: previous.x, y: previous.y }, end: { x: point.x, y: point.y }, layer: point.layer, width: Math.max(previous.width, point.width) }]
+      : []
+  })
+}
+
+function hasConventionalCorners(route: readonly FanoutRoutePoint[]): boolean {
+  for (let index = 1; index < route.length; index++) {
+    const a = route[index - 1]!, b = route[index]!
+    if (a.route_type !== "wire" || b.route_type !== "wire" || a.layer !== b.layer) continue
+    const dx = b.x - a.x, dy = b.y - a.y
+    if (Math.hypot(dx, dy) <= EPSILON || Math.min(Math.abs(dx), Math.abs(dy)) > EPSILON && Math.abs(Math.abs(dx) - Math.abs(dy)) > EPSILON) return false
+    const c = route[index + 1]
+    if (!c || c.route_type !== "wire" || c.layer !== b.layer) continue
+    const ox = c.x - b.x, oy = c.y - b.y, denominator = Math.hypot(dx, dy) * Math.hypot(ox, oy)
+    if (denominator <= EPSILON * EPSILON || (dx * ox + dy * oy) / denominator < Math.SQRT1_2 - EPSILON) return false
+  }
+  return true
+}
+
+/** Clean newly computed source copper without moving terminals or barrels.
+ * Supplied/held traces stay byte exact. Every changed path retains the native
+ * widths and passes source, self and collective physical clearance checks.
+ */
+export function normalizeFreshSourceCorners(params: {
+  inputSrj: SimpleRouteJson
+  plans: readonly FanoutRoutePlan[]
+  clearance: number
+  immutableTraceIds?: ReadonlySet<string>
+}): FanoutRoutePlan[] | null {
+  const { inputSrj, clearance } = params
+  const supplied = new Map((inputSrj.traces ?? []).map(trace => [trace.pcb_trace_id, trace]))
+  const plans: FanoutRoutePlan[] = []
+  for (const original of params.plans) {
+    const inputTrace = supplied.get(original.trace.pcb_trace_id)
+    if (inputTrace && JSON.stringify(inputTrace) !== JSON.stringify(original.trace)) return null
+    const immutable = !!inputTrace || params.immutableTraceIds?.has(original.trace.pcb_trace_id) === true
+    const route = original.trace.route.map(point => ({ ...point }))
+    const escapeEnd = original.sourceEscapeSegmentCount === undefined ? undefined : original.segments[original.sourceEscapeSegmentCount - 1]
