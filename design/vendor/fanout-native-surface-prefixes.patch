+import { test, expect } from "bun:test"
+import type { SimpleRouteJson } from "@tscircuit/capacity-autorouter"
+import { getSvgFromGraphicsObject } from "graphics-debug"
+import { FanoutSolver } from "../lib/index"
+import { routeSingleLayerWithAdaptiveExits } from "../lib/route-single-layer-adaptive-exits"
+import { distanceSegmentToSegment } from "../lib/geometry"
+import { changedFanoutCopperIsSelfClear } from "../lib/normalize-fanout-plan-corners"
+import { validateRoutedCopperDrc } from "../lib/validate-routed-copper-drc"
+import type { FanoutRoutePlan } from "../lib/types"
+
+test("a provisional callback retains clear sources with mandatory priority without a partial successful solve", () => {
+  const sharedBoundary = { minX: -1, maxX: 1, minY: -1, maxY: 1 }
+  const pads = [-.6, 0, .6].map((y, index) => ({ type: "rect" as const, center: { x: -.8, y }, width: .1, height: .1, layers: ["top"], connectedTo: [`SIGNAL_${index}`], componentId: "source-grid", circuitJsonMetadata: { pcb_smtpad_id: `pad_${index}`, pcb_port_id: `port_${index}` } }))
+  // The fine grid admits three vertex-disjoint paths, but real copper spacing
+  // permits the two outside paths or the required middle path alone.
+  const walls = [-1, 1].map(sign => ({ type: "rect" as const, center: { x: .55, y: sign * .625 }, width: .9, height: .75, layers: ["top"], connectedTo: ["foreign"] }))
+  const input: SimpleRouteJson = {
+    layerCount: 4, minTraceWidth: .1, minViaPadDiameter: .3, minViaHoleDiameter: .15,
+    bounds: { minX: -2, maxX: 2, minY: -2, maxY: 2 },
+    connections: pads.map((pad, index) => ({ name: `SIGNAL_${index}`, pointsToConnect: [{ ...pad.center, layer: "top", pcb_port_id: `port_${index}` }, { x: 1.8, y: pad.center.y, layer: "top" }] })),
+    obstacles: [...pads, ...walls, ...["inner1", "inner2"].map(layer => ({ type: "rect" as const, center: { x: 0, y: 0 }, width: 4, height: 4, layers: [layer], connectedTo: ["GND"], isCopperPour: true }))],
+  }
+  const original = JSON.stringify(input)
+  const prepare = () => new FanoutSolver(input, { sharedBoundary, sourceComponentId: "source-grid", buses: input.connections.map(connection => ({ busId: connection.name, connectionNames: [connection.name], sourceComponentId: "source-grid", allowedLayers: ["top"] })) }).preparedBuses
+  const common = { srj: input, traceWidth: .1, clearance: .1, gridStep: .1, maximumConnectorAttempts: 1, rankConnectorsByBoundaryReachability: true, availableBoundaryRegions: [{ direction: "right" as const, preferredExit: "right" as const, exitEdge: "right" as const }] }
+  expect(routeSingleLayerWithAdaptiveExits({ ...common, buses: prepare() })).toBeNull()
+  const subsets: FanoutRoutePlan[][] = []
+  const result = routeSingleLayerWithAdaptiveExits({ ...common, buses: prepare(), prioritySourceConnectionIndexes: new Set([2]), onPartialRoutes: plans => subsets.push(plans) })
+  expect(result).toBeNull()
+  expect(subsets).toHaveLength(1)
+  const outside = subsets[0]!
+  expect(outside.map(plan => plan.connectionIndex)).toEqual([2, 0])
+  for (const plan of outside) {
+    expect(plan.segments.every(segment => segment.width === .1 && segment.layer === "top")).toBe(true)
+    expect(changedFanoutCopperIsSelfClear(plan, plan.segments, .1, new Set(plan.segments.map((_, index) => index)))).toBe(true)
+    expect(plan.trace.route[0]).toMatchObject({ start_pcb_port_id: `port_${plan.connectionIndex}` })
+  }
+  for (const first of outside[0]!.segments) for (const second of outside[1]!.segments)
+    expect(distanceSegmentToSegment(first.start, first.end, second.start, second.end)).toBeGreaterThanOrEqual(.2 - 1e-8)
+  expect(validateRoutedCopperDrc({ inputSrj: input, routedSrj: { ...input, traces: outside.map(plan => plan.trace) }, clearance: .1, allowBlindAndBuriedVias: false })).toMatchObject({ valid: true, issues: [] })
+  const required: FanoutRoutePlan[][] = []
+  expect(routeSingleLayerWithAdaptiveExits({ ...common, buses: prepare(), prioritySourceConnectionIndexes: new Set([1]), onPartialRoutes: plans => required.push(plans) })).toBeNull()
+  expect(required).toHaveLength(1)
+  expect(required[0]!.map(plan => plan.connectionIndex)).toEqual([1])
+  expect(JSON.stringify(input)).toBe(original)
+  expect(getSvgFromGraphicsObject({ title: "Only physically clear provisional paths survive; every input remains unresolved", rects: [...walls.map(wall => ({ center: wall.center, width: wall.width, height: wall.height, fill: "#94a3b8" })), ...pads.map(pad => ({ center: pad.center, width: pad.width, height: pad.height, fill: "#f9a8d4" }))], lines: outside.flatMap(plan => plan.segments.map(segment => ({ points: [segment.start, segment.end], strokeWidth: segment.width, strokeColor: "#2563eb" }))), points: pads.map((pad, index) => ({ ...pad.center, label: index === 2 ? "Required Top" : `Source ${index}` })) })).toMatchSnapshot()
+})
