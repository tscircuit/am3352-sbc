@@ -0,0 +1,255 @@
+import { expect, test } from "bun:test"
+import type { Obstacle, SimpleRouteJson } from "@tscircuit/capacity-autorouter"
+import { type GraphicsObject, getSvgFromGraphicsObject } from "graphics-debug"
+import { distanceSegmentToSegment } from "../lib/geometry"
+import { routeSingleLayerWithAdaptiveExits } from "../lib/route-single-layer-adaptive-exits"
+import type { PreparedBus, PreparedConnection } from "../lib/types"
+import { validateRoutedCopperDrc } from "../lib/validate-routed-copper-drc"
+
+test("fine-grid sources leave only their owned connector halos and preserve foreign copper", async () => {
+  const traceWidth = 0.1
+  const clearance = 0.1
+  const sharedBoundary = { minX: -1, maxX: 1, minY: -1, maxY: 1 }
+  // Each 0.3mm slot has exactly one legal 0.1mm wire centreline. The
+  // coarse 0.2mm lattice misses both; the fine lattice hits y=0.1 and 0.7.
+  const obstacles: Obstacle[] = [
+    { center: { x: 0, y: -0.525 }, width: 2, height: 0.95 },
+    { center: { x: 0, y: 0.4 }, width: 2, height: 0.3 },
+    { center: { x: 0, y: 0.925 }, width: 2, height: 0.15 },
+  ].map((shape) => ({
+    ...shape,
+    type: "rect",
+    layers: ["top"],
+    connectedTo: [],
+  }))
+  const connections: PreparedConnection[] = [0.1, 0.7].map(
+    (y, connectionIndex) => {
+      const name = `signal-${connectionIndex}`
+      const sourceObstacle: Obstacle & {
+        circuitJsonMetadata: { pcb_smtpad_id: string; pcb_port_id: string }
+      } = {
+        type: "rect",
+        center: { x: 0, y },
+        width: 0.1,
+        height: 0.1,
+        layers: ["top"],
+        connectedTo: [name],
+        componentId: "U1",
+        circuitJsonMetadata: {
+          pcb_smtpad_id: `${name}:pad`,
+          pcb_port_id: `${name}:port`,
+        },
+      }
+      obstacles.push(sourceObstacle)
+      const sourcePoint = {
+        x: 0,
+        y,
+        layer: "top",
+        pointId: `${name}:source`,
+        pcb_port_id: `${name}:port`,
+      }
+      const targetPoint = { x: 1, y, layer: "top", pointId: `${name}:exit` }
+      return {
+        connection: { name, pointsToConnect: [sourcePoint, targetPoint] },
+        connectionIndex,
+        sourcePoint,
+        sourcePointIndex: 0,
+        sourceLayer: "top",
+        sourceObstacle,
+        targetPoint,
+        exitTargetPoint: targetPoint,
+        hasExplicitExitTarget: true,
+        hasExplicitLayeredExitTarget: true,
+      }
+    },
+  )
+  const buses: PreparedBus[] = connections.map((connection) => ({
+    busId: connection.connection.name,
+    componentId: "U1",
+    componentObstacles: obstacles,
+    componentBounds: sharedBoundary,
+    sharedBoundary,
+    xCoordinates: [0],
+    yCoordinates: [0.1, 0.7],
+    pitchX: 0.6,
+    pitchY: 0.6,
+    termination: { type: "boundary" },
+    direction: "right",
+    exitEdge: "right",
+    preferredExit: "right",
+    allowedLayers: ["top"],
+    routableEscapeLayers: ["top"],
+    connections: [connection],
+  }))
+  obstacles.push(
+    ...["inner1", "inner2"].map(
+      (layer): Obstacle => ({
+        type: "rect",
+        layers: [layer],
+        center: { x: 0, y: 0 },
+        width: 4,
+        height: 4,
+        isCopperPour: true,
+        connectedTo: ["GND"],
+      }),
+    ),
+  )
+  const srj: SimpleRouteJson & { allowBlindAndBuriedVias: false } = {
+    layerCount: 4,
+    minTraceWidth: traceWidth,
+    minViaPadDiameter: 0.3,
+    minViaHoleDiameter: 0.15,
+    allowBlindAndBuriedVias: false,
+    bounds: { minX: -2, maxX: 2, minY: -2, maxY: 2 },
+    obstacles,
+    connections: connections.map((connection) => connection.connection),
+  }
+  const original = JSON.stringify(srj)
+  const params = {
+    srj,
+    buses,
+    traceWidth,
+    clearance,
+    availableBoundaryRegions: [
+      {
+        direction: "right" as const,
+        preferredExit: "right" as const,
+        exitEdge: "right" as const,
+      },
+    ],
+  }
+  expect(routeSingleLayerWithAdaptiveExits(params)).toBeNull()
+  const plans = routeSingleLayerWithAdaptiveExits({ ...params, gridStep: 0.1 })
+  expect(plans).toHaveLength(2)
+  if (!plans)
+    throw new Error("Both native sources must escape the fine-grid channels")
+  for (const plan of plans) {
+    const connection = connections[plan.connectionIndex]!
+    expect(plan.sourcePoint).toBe(connection.sourcePoint)
+    expect(plan.sourceObstacle).toBe(connection.sourceObstacle)
+    expect(plan.trace.route[0]).toMatchObject({
+      x: connection.sourcePoint.x,
+      y: connection.sourcePoint.y,
+      start_pcb_port_id: connection.sourcePoint.pcb_port_id,
+    })
+    expect(plan.trace.connectsTo).toContain(connection.sourcePoint.pointId!)
+    expect(plan.trace.connectsTo).toContain(connection.sourcePoint.pcb_port_id!)
+    expect(plan.segments.at(-1)!.end).toEqual(plan.exitPoint)
+    expect(plan.exitPoint.x).toBe(1)
+    expect(plan.exitPoint.y).toBeCloseTo(connection.sourcePoint.y, 12)
+    for (const segment of plan.segments) {
+      expect(segment.layer).toBe("top")
+      expect(segment.width).toBe(traceWidth)
+      const dx = Math.abs(segment.start.x - segment.end.x)
+      const dy = Math.abs(segment.start.y - segment.end.y)
+      expect(dx < 1e-8 || dy < 1e-8 || Math.abs(dx - dy) < 1e-8).toBe(true)
+    }
+  }
+  for (const first of plans[0]!.segments)
+    for (const second of plans[1]!.segments)
+      expect(
+        distanceSegmentToSegment(
+          first.start,
+          first.end,
+          second.start,
+          second.end,
+        ),
+      ).toBeGreaterThanOrEqual(traceWidth + clearance - 1e-8)
+  expect(
+    validateRoutedCopperDrc({
+      inputSrj: srj,
+      routedSrj: { ...srj, traces: plans.map((plan) => plan.trace) },
+      clearance,
+      allowBlindAndBuriedVias: false,
+    }),
+  ).toMatchObject({
+    valid: true,
+    checkedTraceCount: 2,
+    checkedViaCount: 0,
+    issues: [],
+  })
+  expect(JSON.stringify(srj)).toBe(original)
+  const open = {
+    ...srj,
+    obstacles: obstacles.filter((obstacle) => obstacle.connectedTo.length > 0),
+  }
+  const defaultPlans = routeSingleLayerWithAdaptiveExits({
+    ...params,
+    srj: open,
+  })
+  expect(defaultPlans).toHaveLength(2)
+  expect(
+    routeSingleLayerWithAdaptiveExits({
+      ...params,
+      srj: open,
+      gridStep: traceWidth + clearance,
+    }),
+  ).toEqual(defaultPlans)
+
+  // Supplied foreign copper seals only the lower slot. A source-local halo
+  // exemption must neither open that copper nor return the other source alone.
+  const blocked = structuredClone(srj)
+  blocked.obstacles.push({
+    type: "rect",
+    layers: ["top"],
+    center: { x: 0.5, y: 0.1 },
+    width: 0.1,
+    height: 0.4,
+    connectedTo: ["foreign"],
+    obstacleId: "supplied-foreign-copper",
+  })
+  blocked.traces = [
+    {
+      type: "pcb_trace",
+      pcb_trace_id: "fixed-foreign",
+      connection_name: "foreign",
+      route: [
+        { route_type: "wire", x: 0.5, y: -0.1, layer: "top", width: 0.1 },
+        { route_type: "wire", x: 0.5, y: 0.3, layer: "top", width: 0.1 },
+      ],
+    },
+  ]
+  const blockedOriginal = JSON.stringify(blocked)
+  expect(
+    routeSingleLayerWithAdaptiveExits({
+      ...params,
+      srj: blocked,
+      gridStep: 0.1,
+    }),
+  ).toBeNull()
+  expect(JSON.stringify(blocked)).toBe(blockedOriginal)
+  for (const gridStep of [0, Number.NaN, 0.3])
+    expect(() =>
+      routeSingleLayerWithAdaptiveExits({ ...params, gridStep }),
+    ).toThrow("gridStep")
+
+  const graphics: GraphicsObject = {
+    title: "Owned source egress through fine-grid channels",
+    rects: obstacles
+      .filter((obstacle) => !obstacle.isCopperPour)
+      .map((obstacle) => ({
+        center: obstacle.center,
+        width: obstacle.width,
+        height: obstacle.height,
+        fill: obstacle.connectedTo.length ? "#f97316" : "#e2e8f0",
+      })),
+    lines: plans.flatMap((plan, index) =>
+      plan.segments.map((segment) => ({
+        points: [segment.start, segment.end],
+        strokeWidth: traceWidth,
+        strokeColor: index === 0 ? "#2563eb" : "#059669",
+      })),
+    ),
+    texts: [
+      {
+        x: 0,
+        y: 1.25,
+        text: "0.1mm wires · 0.1mm clearance · 0.1mm grid",
+        fontSize: 0.12,
+      },
+    ],
+  }
+  await expect(getSvgFromGraphicsObject(graphics)).toMatchSvgSnapshot(
+    import.meta.path,
+  )
+})
diff --git a/tests/copper-pour-through-via-reservation.test.ts b/tests/copper-pour-through-via-reservation.test.ts
