+    const remember = (plans: FanoutRoutePlan[]): void => {
+      const ids = new Set(plans.map(plan => plan.connectionIndex))
+      const mandatoryCount = [...requiredSource].filter(index => ids.has(index)).length
+      if (mandatoryCount > bestMandatoryCount || mandatoryCount === bestMandatoryCount && plans.length > best.length) {
+        best = plans
+        bestMandatoryCount = mandatoryCount
+      }
+    }
+    const flow = routeSingleLayerWithAdaptiveExitsSteps({ srj: scene, buses: sourceBuses, traceWidth, clearance, gridStep, rankConnectorsByBoundaryReachability: true, maximumConnectorAttempts: params.maximumConnectorAttempts ?? 8, prioritySourceConnectionIndexes: requiredSource, onPartialRoutes: remember })
+    let next = flow.next()
+    while (!next.done) {
+      yield
+      next = flow.next()
+    }
+    if (next.value)
+      remember(next.value)
+    return best
+  }
+  if (params.criticalSourceCorridors) params.onProgress?.({ phase: "critical-source-corridors", sourceCount: heldMandatoryPlans.length, bridgeCount: buses.length - heldMandatoryPlans.length, sourceConnectionIndexes: [...criticalSource] })
+  const heldMandatoryObstacles: Obstacle[] = heldMandatoryPlans.flatMap(plan => plan.segments.map(segment => ({
+    type: "rect" as const,
+    center: { x: (segment.start.x + segment.end.x) / 2, y: (segment.start.y + segment.end.y) / 2 },
+    width: Math.hypot(segment.end.x - segment.start.x, segment.end.y - segment.start.y) + segment.width,
