+++ b/tests/critical-source-outward-native-seven.test.ts
@@ -0,0 +1,88 @@
+import { expect, test } from "bun:test"
+import type { Obstacle, SimpleRouteJson } from "@tscircuit/capacity-autorouter"
+import { getSvgFromGraphicsObject } from "graphics-debug"
+import nativeLocal from "./fixtures/source-seven-native-local.json"
+import { prepareFanoutBuses } from "../lib/prepare-buses"
+import { selectCriticalSourceCorridorsSteps } from "../lib/select-critical-source-corridors"
+import { getComponentDogboneViaSiteCandidates, matchComponentDogboneViaSites } from "../lib/match-component-dogbone-via-sites"
+import { distancePointToObstacle } from "../lib/geometry"
+import { validateRoutedCopperDrc } from "../lib/validate-routed-copper-drc"
+import type { FanoutSimplifiedPcbTrace } from "../lib/types"
+
+test("captured source 7 chooses the outward Right corridor while preserving source 3's two drilled sites", () => {
+  // Geometry-only crop of the native CONTROL capture: 24 actual circular BGA
+  // pads, the local Bottom passives/fixed copper/barrels, and both inner pours.
+  // Large foreign connectivity alias lists are reduced to their native owner.
+  // Source 3/5/7 keep their captured coordinates, terminals, and port identities.
+  const input = structuredClone(nativeLocal) as SimpleRouteJson
+  const original = JSON.stringify(input)
+  const buses = prepareFanoutBuses(input, { sourceComponentId: "pcb_component_0", sharedBoundary: input.bounds,
+    buses: input.connections.map(connection => ({ busId: connection.name, connectionNames: [connection.name],
+      sourceComponentId: "pcb_component_0", allowedLayers: ["top", "bottom"] })) })
+  const third = buses.find(bus => bus.busId === "source_net_3")!
+  const fifth = buses.find(bus => bus.busId === "source_net_5")!
+  const seventh = buses.find(bus => bus.busId === "source_net_7")!
+  const rules = { traceWidth: .1, clearance: .1, viaDiameter: .3, viaHoleDiameter: .15,
+    expandLocalSites: true, additionalObstacles: input.obstacles }
+  const source = seventh.connections[0]!.sourcePoint
+  expect(source.x).toBeCloseTo(6.8, 9)
+  expect(source.y).toBe(-4.4)
+  expect(seventh.connections[0]!.sourcePointIndex).toBe(1)
+  expect(getComponentDogboneViaSiteCandidates([fifth], rules)).toHaveLength(0)
+  expect(getComponentDogboneViaSiteCandidates([seventh], rules)).toHaveLength(0)
+  const baseline = getComponentDogboneViaSiteCandidates([third], rules)
+  expect(baseline.map(candidate => candidate.point)).toEqual([{ x: 6.3, y: -3.6 }, { x: 6.35, y: -3.6 }])
+  const work = selectCriticalSourceCorridorsSteps({ srj: input, buses, ...rules })
+  let next = work.next()
+  while (!next.done) next = work.next()
+  expect(next.value).toHaveLength(2)
+  const plans = next.value!
+  const outward = plans.find(plan => plan.connectionName === seventh.busId)!
+  expect(plans.every(plan => plan.direction === "right" && plan.targetLayer === "top" && !plan.via)).toBe(true)
+  expect(outward.length).toBeCloseTo(input.bounds.maxX - source.x, 9)
+  expect(outward.trace.route[0]).toMatchObject({ x: source.x, y: source.y, layer: "top", start_pcb_port_id: source.pcb_port_id })
+  const blockingSegments = plans.flatMap(plan => plan.segments.map(segment => ({ connectionIndex: plan.connectionIndex, segment })))
+  const remainingRules = { ...rules, blockingSegments }
+  expect(getComponentDogboneViaSiteCandidates([third], remainingRules)).toEqual(baseline)
+  const joint = matchComponentDogboneViaSites([third], remainingRules)
+  expect(joint?.size).toBe(1)
+  const site = joint!.get(third.connections[0]!.connectionIndex)!
+  expect(distancePointToObstacle(site, third.connections[0]!.sourceObstacle)).toBeGreaterThan(.15 / 2 + .02)
+  for (const obstacle of input.obstacles)
+    if (obstacle !== third.connections[0]!.sourceObstacle && !obstacle.isCopperPour)
+      expect(distancePointToObstacle(site, obstacle)).toBeGreaterThanOrEqual(.3 / 2 + .1 - 1e-9)
+  // This legal octilinear inward Top prefix enters the half-pitch channel just
+  // east of source 3. Its copper clears native pads but steals both through-via
+  // lands, illustrating why native domains must be part of corridor selection.
+  const inwardX = third.connections[0]!.sourcePoint.x + third.pitchX / 2
+  const inwardPoints = [source, { x: inwardX, y: source.y + Math.abs(source.x - inwardX) },
+    { x: inwardX, y: input.bounds.maxY }]
+  const inward: FanoutSimplifiedPcbTrace = { type: "pcb_trace", pcb_trace_id: "fresh-inward-diagnostic",
+    connection_name: seventh.busId, route: inwardPoints.map((point, index) => ({ route_type: "wire" as const,
+      ...point, layer: "top", width: .1, ...(index === 0 ? { start_pcb_port_id: source.pcb_port_id } : {}) })) }
+  const inwardSegments = inwardPoints.slice(1).map((end, index) => ({ start: inwardPoints[index]!, end, width: .1, layer: "top" }))
+  expect(validateRoutedCopperDrc({ inputSrj: input, routedSrj: { ...input, traces: [inward] },
+    clearance: .1, allowBlindAndBuriedVias: false })).toMatchObject({ valid: true, issues: [] })
+  expect(getComponentDogboneViaSiteCandidates([third], { ...rules,
+    blockingSegments: inwardSegments.map(segment => ({ connectionIndex: seventh.connections[0]!.connectionIndex, segment })) })).toHaveLength(0)
+  expect(validateRoutedCopperDrc({ inputSrj: input, routedSrj: { ...input, traces: plans.map(plan => plan.trace) },
+    clearance: .1, allowBlindAndBuriedVias: false })).toMatchObject({ valid: true, issues: [] })
+  expect(JSON.stringify(input)).toBe(original)
+  expect(getSvgFromGraphicsObject({ title: "Captured source 7: Right exit preserves source 3's .30/.15 drilled sites",
+    rects: input.obstacles.filter(obstacle => !obstacle.isCopperPour &&
+      (obstacle as Obstacle & { shape?: string }).shape !== "circle")
+      .map(obstacle => ({ center: obstacle.center, width: obstacle.width, height: obstacle.height,
+        fill: obstacle.layers.includes("top") ? "#cbd5e1" : "#dcfce7", stroke: "#94a3b8" })),
+    circles: [...input.obstacles.filter(obstacle => (obstacle as Obstacle & { shape?: string }).shape === "circle")
+      .map(obstacle => ({ center: obstacle.center, radius: obstacle.width / 2,
+        fill: obstacle.componentId === "pcb_component_0" ? "#94a3b8" : "#e2e8f0", stroke: "#64748b" })),
+      ...baseline.flatMap(candidate => [{ center: candidate.point, radius: .3 / 2, fill: "#bbf7d0", stroke: "#15803d" },
+        { center: candidate.point, radius: .15 / 2, fill: "white", stroke: "#334155" }])],
+    lines: [...plans.flatMap(plan => plan.segments.map(segment => ({ points: [segment.start, segment.end],
+      strokeWidth: segment.width, strokeColor: "#2563eb" }))),
+      { points: [inwardPoints[0]!, inwardPoints[1]!, { x: inwardX, y: third.connections[0]!.sourcePoint.y + third.pitchY }],
+        strokeWidth: .1, strokeColor: "#dc2626" }],
+    points: [{ ...source, label: "source 7 → Right" }, { ...fifth.connections[0]!.sourcePoint, label: "critical source 5 → Right" },
+      { ...third.connections[0]!.sourcePoint, label: "source 3: two preserved via sites" }],
+  })).toMatchSnapshot()
+})
