+      const direction = Math.abs(plan.exitPoint.x - sharedBoundary.minX) < 1e-7 ? "left" :
+        Math.abs(plan.exitPoint.x - sharedBoundary.maxX) < 1e-7 ? "right" :
+          Math.abs(plan.exitPoint.y - sharedBoundary.minY) < 1e-7 ? "down" : "up"
