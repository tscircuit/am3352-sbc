+++ b/tests/critical-source-corridors.test.ts
@@ -0,0 +1,175 @@
+import { expect, test } from "bun:test"
+import type { Obstacle, SimpleRouteJson } from "@tscircuit/capacity-autorouter"
+import { getSvgFromGraphicsObject } from "graphics-debug"
+import { prepareFanoutBuses } from "../lib/prepare-buses"
+import { selectCriticalSourceCorridorsSteps } from "../lib/select-critical-source-corridors"
+import { routeMixedSurfaceSourcePrefixesSteps } from "../lib/route-mixed-surface-source-prefixes"
+import { getComponentDogboneViaSiteCandidates, matchComponentDogboneViaSites } from "../lib/match-component-dogbone-via-sites"
+import { buildOutputSimpleRouteJson } from "../lib/build-output"
+import { distancePointToObstacle } from "../lib/geometry"
+import { validateRoutedCopperDrc } from "../lib/validate-routed-copper-drc"
+import { createNativeLayerDogboneFixture } from "./fixtures/native-layer-dogbone"
+import type { FanoutRoutePlan, FanoutSimplifiedPcbTrace } from "../lib/types"
+
+function fixture(): SimpleRouteJson {
+  const { input } = createNativeLayerDogboneFixture()
+  const outward = input.obstacles.find(obstacle => obstacle.center.x === 0 && obstacle.center.y === .8)! as
+    Obstacle & { circuitJsonMetadata?: { pcb_port_id: string } }
+  outward.connectedTo = ["OUTWARD", "outward-port"]
+  outward.circuitJsonMetadata = { pcb_port_id: "outward-port" }
+  // Downstream is intentionally first: the source identity is index 1.
+  input.connections.push({ name: "OUTWARD", pointsToConnect: [
+    { x: 2, y: 0, layer: "top", pointId: "outward-target" },
+    { x: 0, y: .8, layer: "top", pcb_port_id: "outward-port" },
+  ] })
+  input.obstacles.push(
+    { type: "rect", center: { x: 0, y: .8 }, width: 1.2, height: .7,
+      layers: ["bottom"], connectedTo: ["native-bottom-pad"] },
+    { type: "rect", shape: "circle", center: { x: -1.35, y: 1.15 }, width: .3, height: .3,
+      layers: ["top", "inner1", "inner2", "bottom"], connectedTo: ["native-via"],
+      circuitJsonMetadata: { pcb_via_id: "native-via" } } as Obstacle,
+    { type: "rect", shape: "circle", center: { x: 1.3, y: 1.4 }, width: .35, height: .35,
+      layers: ["top", "inner1", "inner2", "bottom"], connectedTo: [], isNonPlatedHole: true } as Obstacle,
+    ...["inner1", "inner2"].map(layer => ({ type: "rect" as const, center: { x: 0, y: 0 },
+      width: 4, height: 4, layers: [layer], isCopperPour: true, connectedTo: ["GND"] })),
+  )
+  return input
+}
+
+function prepare(input: SimpleRouteJson) {
+  return prepareFanoutBuses(input, { sharedBoundary: input.bounds, sourceComponentId: "source-grid",
+    buses: input.connections.map(connection => ({ busId: connection.name,
+      connectionNames: [connection.name], sourceComponentId: "source-grid", allowedLayers: ["top", "bottom"] })) })
+}
+
+const rules = { traceWidth: .1, clearance: .1, viaDiameter: .3, viaHoleDiameter: .15, expandLocalSites: true }
+function solve(input: SimpleRouteJson): { plans: FanoutRoutePlan[] | null; yields: number } {
+  const work = selectCriticalSourceCorridorsSteps({ srj: input, buses: prepare(input), ...rules })
+  let next = work.next(), yields = 0
+  while (!next.done) {
+    yields++
+    next = work.next()
+  }
+  return { plans: next.value, yields }
+}
+
+test("an outward critical source preserves the remaining actual four-layer drilled-via domain", () => {
+  const input = fixture(), original = JSON.stringify(input), buses = prepare(input)
+  const required = buses.find(bus => bus.busId === "OUTWARD")!
+  const remaining = buses.filter(bus => bus !== required)
+  expect(getComponentDogboneViaSiteCandidates([required], { ...rules, additionalObstacles: input.obstacles })).toHaveLength(0)
+  const initialDomain = getComponentDogboneViaSiteCandidates(remaining, { ...rules, additionalObstacles: input.obstacles })
+  expect(initialDomain.length).toBeGreaterThan(0)
+  const result = solve(input)
+  expect(result.yields).toBeGreaterThan(0)
+  expect(result.plans).toHaveLength(1)
+  const plans = result.plans!
+  const plan = plans[0]!
+  expect(plan.connectionIndex).toBe(1)
+  expect(plan.sourcePointIndex).toBe(1)
+  expect(plan.sourcePoint).toEqual(input.connections[1]!.pointsToConnect[1]!)
+  expect(plan.exitEdge).toBeUndefined()
+  expect(plan.targetPoint).toEqual(input.connections[1]!.pointsToConnect[0]!)
+  expect(plan.targetLayer).toBe("top")
+  expect(plan.direction).toBe("up")
+  expect(plan.via).toBeUndefined()
+  const blockers = plans.flatMap(owner => owner.segments.map(segment => ({ connectionIndex: owner.connectionIndex, segment })))
+  const finalRules = { ...rules, additionalObstacles: input.obstacles, blockingSegments: blockers }
+  const preserved = getComponentDogboneViaSiteCandidates(remaining, finalRules)
+  expect(preserved).toHaveLength(initialDomain.length)
+  const matched = matchComponentDogboneViaSites(remaining, finalRules)
+  expect(matched?.size).toBe(remaining.length)
+  const via = matched!.get(remaining[0]!.connections[0]!.connectionIndex)!
+  expect(distancePointToObstacle(via, remaining[0]!.connections[0]!.sourceObstacle)).toBeGreaterThan(.15 / 2 + .1)
+  expect(plans.flatMap(owner => owner.segments).every(segment => {
+    const dx = Math.abs(segment.end.x - segment.start.x), dy = Math.abs(segment.end.y - segment.start.y)
+    return Math.min(dx, dy, Math.abs(dx - dy)) < 1e-7
+  })).toBe(true)
+  const output = buildOutputSimpleRouteJson({ inputSrj: input, plans, layerNames: ["top", "inner1", "inner2", "bottom"] })
+  expect(output.connections[1]!.pointsToConnect[0]).toEqual(input.connections[1]!.pointsToConnect[0])
+  expect(validateRoutedCopperDrc({ inputSrj: input,
+    routedSrj: { ...input, traces: [...(input.traces ?? []), ...plans.map(owner => owner.trace)] },
+    clearance: .1, allowBlindAndBuriedVias: false })).toMatchObject({ valid: true, issues: [] })
+  const bridge = remaining[0]!.connections[0]!
+  const bridgeTrace: FanoutSimplifiedPcbTrace = { type: "pcb_trace", pcb_trace_id: "preserved-native-dogbone",
+    connection_name: bridge.connection.name, route: [
+      { route_type: "wire", ...bridge.sourcePoint, layer: "top", width: .1, start_pcb_port_id: bridge.sourcePoint.pcb_port_id },
+      { route_type: "wire", ...via, layer: "top", width: .1 },
+      { route_type: "via", ...via, from_layer: "top", to_layer: "bottom", via_diameter: .3,
+        via_hole_diameter: .15, layers: ["top", "inner1", "inner2", "bottom"] },
+      { route_type: "wire", ...via, layer: "bottom", width: .1 },
+      { route_type: "wire", x: input.bounds.minX, y: via.y, layer: "bottom", width: .1 },
+    ] }
+  expect(validateRoutedCopperDrc({ inputSrj: input,
+    routedSrj: { ...input, traces: [...plans.map(owner => owner.trace), bridgeTrace] },
+    clearance: .1, allowBlindAndBuriedVias: false })).toMatchObject({ valid: true, issues: [] })
+  expect(JSON.stringify(input)).toBe(original)
+  const translated = structuredClone(input), dx = 7, dy = -3
+  translated.bounds = { minX: input.bounds.minX + dx, maxX: input.bounds.maxX + dx,
+    minY: input.bounds.minY + dy, maxY: input.bounds.maxY + dy }
+  for (const obstacle of translated.obstacles) {
+    obstacle.center.x += dx
+    obstacle.center.y += dy
+  }
+  for (const connection of translated.connections) for (const point of connection.pointsToConnect) {
+    point.x += dx
+    point.y += dy
+  }
+  const shifted = solve(translated).plans!
+  expect(shifted).toHaveLength(plans.length)
+  expect(shifted[0]!.direction).toBe(plan.direction)
+  expect(shifted[0]!.length).toBeCloseTo(plan.length, 7)
+  expect(shifted[0]!.trace.route).toHaveLength(plan.trace.route.length)
+  for (let index = 0; index < plan.trace.route.length; index++) {
+    const a = plan.trace.route[index]!, b = shifted[0]!.trace.route[index]!
+    if (a.route_type !== "wire" || b.route_type !== "wire") throw new Error("Source corridor changed layers")
+    expect(b.x - dx).toBeCloseTo(a.x, 7)
+    expect(b.y - dy).toBeCloseTo(a.y, 7)
+  }
+  const bottomSource = structuredClone(input)
+  const opposite = (layer: string): string => layer === "top" ? "bottom" : layer === "bottom" ? "top" : layer
+  for (const obstacle of bottomSource.obstacles) obstacle.layers = obstacle.layers.map(opposite)
+  for (const connection of bottomSource.connections) for (const point of connection.pointsToConnect)
+    if ("layer" in point) point.layer = opposite(point.layer)
+  const bottomPlans = solve(bottomSource).plans!
+  expect(bottomPlans).toHaveLength(1)
+  expect(bottomPlans[0]!.sourceLayer).toBe("bottom")
+  expect(bottomPlans[0]!.targetLayer).toBe("bottom")
+  expect(bottomPlans[0]!.direction).toBe("up")
+  const mixed = routeMixedSurfaceSourcePrefixesSteps({ srj: input, buses: prepare(input), ...rules,
+    gridStep: .1, criticalSourceCorridors: true })
+  let mixedNext = mixed.next()
+  while (!mixedNext.done) mixedNext = mixed.next()
+  expect(mixedNext.value).toHaveLength(input.connections.length)
+  expect(mixedNext.value!.find(owner => owner.connectionName === "OUTWARD")!.trace).toEqual(plan.trace)
+  expect(validateRoutedCopperDrc({ inputSrj: input,
+    routedSrj: { ...input, traces: mixedNext.value!.map(owner => owner.trace) },
+    clearance: .1, allowBlindAndBuriedVias: false })).toMatchObject({ valid: true, issues: [] })
+  const blocked = structuredClone(input)
+  // The second required source is enclosed; committing only OUTWARD is forbidden.
+  blocked.obstacles.push({ type: "rect", center: { x: 0, y: 0 }, width: 1.2, height: 1.2,
+    layers: ["bottom"], connectedTo: ["no-native-via"] },
+    ...[
+      { x: 0, y: .5, width: 1.2, height: .1 }, { x: 0, y: -.5, width: 1.2, height: .1 },
+      { x: .5, y: 0, width: .1, height: 1.2 }, { x: -.5, y: 0, width: .1, height: 1.2 },
+    ].map(wall => ({ type: "rect" as const, center: { x: wall.x, y: wall.y },
+      width: wall.width, height: wall.height, layers: ["top"], connectedTo: ["enclosure"] })))
+  expect(solve(blocked).plans).toBeNull()
+  expect(() => selectCriticalSourceCorridorsSteps({ srj: input, buses, ...rules, maximumCandidateSearchStates: 0 }).next())
+    .toThrow("positive safe integer")
+  expect(getSvgFromGraphicsObject({ title: "Outward Top source corridor preserves a native .30/.15 four-layer dogbone",
+    rects: input.obstacles.filter(obstacle => obstacle.layers.length === 1 && !obstacle.isCopperPour &&
+      (obstacle as Obstacle & { shape?: string }).shape !== "circle")
+      .map(obstacle => ({ center: obstacle.center, width: obstacle.width, height: obstacle.height,
+        fill: obstacle.layers[0] === "top" ? "#94a3b8" : "#dcfce7" })),
+    lines: [...plans.flatMap(owner => owner.segments.map(segment => ({ points: [segment.start, segment.end],
+      strokeWidth: segment.width, strokeColor: "#2563eb" }))),
+      { points: [remaining[0]!.connections[0]!.sourcePoint, via], strokeWidth: .1, strokeColor: "#15803d" }],
+    circles: [...input.obstacles.filter(obstacle => (obstacle as Obstacle & { shape?: string }).shape === "circle")
+      .map(obstacle => ({ center: obstacle.center, radius: obstacle.width / 2,
+        fill: obstacle.layers.length === 1 ? "#94a3b8" : "#f1f5f9", stroke: "#64748b" })),
+      { center: via, radius: .3 / 2, fill: "#bbf7d0", stroke: "#15803d" },
+      { center: via, radius: .15 / 2, fill: "white", stroke: "#334155" }],
+    points: [{ ...plan.sourcePoint, label: "source index 1 → Top edge" }, { ...via, label: "preserved drilled via" }],
+  })).toMatchSnapshot()
+})
diff --git a/tests/critical-source-outward-native-seven.test.ts b/tests/critical-source-outward-native-seven.test.ts
