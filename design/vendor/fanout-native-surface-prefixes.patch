+import { expect, test } from "bun:test"
+import { getSvgFromGraphicsObject, type GraphicsObject } from "graphics-debug"
+import { distancePointToObstacle, distanceSegmentToObstacle } from "../lib/geometry"
+import { getComponentDogboneViaSiteCandidates } from "../lib/match-component-dogbone-via-sites"
+import { createNativeLayerDogboneFixture } from "./fixtures/native-layer-dogbone"
+
+test("a top dogbone ignores bottom wire overlap while its full-span via clears every pad", () => {
+  const { input, bus, bottomPad } = createNativeLayerDogboneFixture()
+  const original = JSON.stringify(input)
+  const point = { x: -0.4, y: 0.4 }
+  const segment = { start: { x: 0, y: 0 }, end: point, layer: "top", width: 0.1 }
+  const rules = {
+    viaDiameter: 0.3,
+    viaHoleDiameter: 0.15,
+    traceWidth: 0.1,
+    clearance: 0.1,
+    fixedViaPointsByConnectionIndex: new Map([[0, point]]),
+  }
+  expect(distanceSegmentToObstacle(segment, bottomPad)).toBeLessThan(0.15)
+  expect(distancePointToObstacle(point, bottomPad) - 0.15).toBeGreaterThan(0.4)
+  expect(getComponentDogboneViaSiteCandidates([bus], { ...rules, additionalObstacles: input.obstacles })).toEqual([{ connectionIndex: 0, point }])
+  expect(getComponentDogboneViaSiteCandidates([bus], { ...rules, additionalObstacles: [...input.obstacles.filter((obstacle) => obstacle !== bottomPad), { ...bottomPad, layers: ["top"] }] })).toEqual([])
+  expect(getComponentDogboneViaSiteCandidates([bus], { ...rules, additionalObstacles: [...input.obstacles, { ...bottomPad, center: point, width: 0.2, height: 0.2 }] })).toEqual([])
+  expect(JSON.stringify(input)).toBe(original)
+  const graphics: GraphicsObject = {
+    lines: [{ points: [segment.start, segment.end], strokeColor: "#2563eb", strokeWidth: segment.width }],
+    circles: [{ center: segment.start, radius: 0.2, fill: "#93c5fd" }, { center: point, radius: 0.15, fill: "#2563eb" }],
+    rects: [{ center: bottomPad.center, width: bottomPad.width, height: bottomPad.height, fill: "#fca5a5" }],
+    texts: [{ x: 0, y: 0.8, text: "TOP wire crosses BOTTOM pad; via clears both", fontSize: 0.08 }],
+  }
+  expect(getSvgFromGraphicsObject(graphics)).toMatchSnapshot()
+})
diff --git a/tests/expanded-conventional-dogbone-sites.test.ts b/tests/expanded-conventional-dogbone-sites.test.ts
