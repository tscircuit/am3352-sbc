+import { validateRoutedCopperDrc } from "../lib/validate-routed-copper-drc"
+
+test("actual Bottom source routing preserves Top obstacles and both inner ground layers", async () => {
+  const traceWidth = 0.1
+  const clearance = 0.1
+  const sharedBoundary = { minX: -1, maxX: 1, minY: -1, maxY: 1 }
