+import { validateRoutedCopperDrc } from "../lib/validate-routed-copper-drc"
+import type { FanoutRoutePlan } from "../lib/types"
+test("a fresh source prefix removes a local returning fold while preserving its native terminals", () => {
+  const source = { x: .4, y: .4, layer: "top", pcb_port_id: "actual-source-port" }, target = { x: -1, y: 0, layer: "top" }
+  const pad = { type: "rect" as const, center: source, width: .3, height: .3, layers: ["top"], connectedTo: ["DATA", "actual-source-port"] }
+  const input: SimpleRouteJson = { layerCount: 4, minTraceWidth: .1, bounds: { minX: -2, maxX: 2, minY: -2, maxY: 2 }, obstacles: [pad, ...["inner1", "inner2"].map(layer => ({ type: "rect" as const, center: { x: 0, y: 0 }, width: 4, height: 4, layers: [layer], isCopperPour: true, connectedTo: ["GND"] }))], connections: [{ name: "DATA", pointsToConnect: [source, target] }] }
+  const points = [source, { x: .4, y: .05 }, { x: .35, y: 0 }, { x: .25, y: 0 }, { x: .2, y: -.05 }, { x: .15, y: -.1 }, { x: .1, y: -.15 }, { x: 1 / 15, y: -11 / 60 }, { x: 1 / 30, y: -11 / 60 }, { x: 0, y: -.15 }, { x: 0, y: -.05 }, { x: -.05, y: 0 }, target]
+  const segments = points.slice(1).map((end, index) => ({ start: points[index]!, end, width: .1, layer: "top" }))
+  const plan: FanoutRoutePlan = { busId: "data", connectionName: "DATA", connectionIndex: 0, sourcePointIndex: 0, sourcePoint: source, sourceObstacle: pad, sourceLayer: "top", targetPoint: target, targetLayer: "top", termination: { type: "boundary" }, direction: "left", exitPoint: target, length: segments.reduce((sum, segment) => sum + Math.hypot(segment.end.x - segment.start.x, segment.end.y - segment.start.y), 0), segments, trace: { type: "pcb_trace", pcb_trace_id: "fresh-data-prefix", connection_name: "DATA", route: points.map((point, index) => ({ ...point, route_type: "wire", layer: "top", width: .1, ...(index === 0 ? { start_pcb_port_id: source.pcb_port_id } : {}) })) } }
+  const before = JSON.stringify({ input, plan }), normalized = normalizeFreshSourceFolds({ inputSrj: input, plans: [plan], clearance: .1 })
+  expect(normalized).toHaveLength(1)
+  const result = normalized![0]!
+  expect(result.length).toBeLessThan(plan.length)
+  expect(result.trace.route[0]).toEqual(plan.trace.route[0])
+  expect(result.trace.route.at(-1)).toEqual(plan.trace.route.at(-1))
+  expect(changedFanoutCopperIsSelfClear(result, result.segments, .1, new Set(result.segments.map((_, index) => index)))).toBe(true)
+  expect(validateRoutedCopperDrc({ inputSrj: input, routedSrj: { ...input, traces: [result.trace] }, clearance: .1, allowBlindAndBuriedVias: false })).toMatchObject({ valid: true, issues: [] })
+  expect(JSON.stringify({ input, plan })).toBe(before)
+  expect(getSvgFromGraphicsObject({ title: "A fresh source fold becomes one clear native path", lines: [{ points, strokeColor: "#94a3b8", strokeWidth: .025 }, { points: [result.segments[0]!.start, ...result.segments.map(segment => segment.end)], strokeColor: "#15803d", strokeWidth: .05 }], points: [{ ...source, label: "native source" }, { ...target, label: "unchanged boundary" }] })).toMatchSnapshot()
+})
