+  if (!selectedCorridors) return null
+  const criticalSource = new Set(selectedCorridors.map(plan => plan.connectionIndex))
+  if (params.criticalSourceCorridors && [...mandatorySource].some(index => !criticalSource.has(index))) return null
+  if (selectedCorridors.length) {
+    const normalized = normalizeFreshSourceCorners({ inputSrj: srj, plans: selectedCorridors, clearance,
+      immutableTraceIds: new Set(selectedCorridors.map(plan => plan.trace.pcb_trace_id)) })
+    if (!normalized || normalized.length !== criticalSource.size || normalized.some(plan => {
+      const owner = buses.find(bus => bus.connections[0]!.connectionIndex === plan.connectionIndex)
