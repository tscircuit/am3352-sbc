+import type { Obstacle, SimpleRouteJson } from "@tscircuit/capacity-autorouter"
+import { prepareFanoutBuses } from "../../lib/prepare-buses"
+import type { PreparedBus } from "../../lib/types"
+
+export function createNativeLayerDogboneFixture(): {
+  input: SimpleRouteJson
+  bus: PreparedBus
+  bottomPad: Obstacle
+} {
+  const componentPads: Obstacle[] = [-0.8, 0, 0.8].flatMap((x, column) =>
+    [-0.8, 0, 0.8].map((y, row) => ({
+      type: "rect" as const,
+      shape: "circle" as const,
+      obstacleId: `pad-${column}-${row}`,
+      componentId: "source-grid",
+      center: { x, y },
+      width: 0.4,
+      height: 0.4,
+      layers: ["top"],
+      connectedTo: column === 1 && row === 1 ? ["SIGNAL", "source-port"] : [`other-${column}-${row}`],
+      circuitJsonMetadata: { pcb_port_id: column === 1 && row === 1 ? "source-port" : `other-port-${column}-${row}` },
+    })),
+  )
+  const bottomPad: Obstacle = {
+    type: "rect",
+    obstacleId: "bottom-capacitor-pad",
+    center: { x: 0.2, y: -0.38 },
+    width: 0.64,
+    height: 0.54,
+    layers: ["bottom"],
+    connectedTo: ["SUPPLY"],
+  }
+  const input: SimpleRouteJson = {
+    layerCount: 4,
+    minTraceWidth: 0.1,
+    minViaPadDiameter: 0.3,
+    minViaHoleDiameter: 0.15,
+    bounds: { minX: -2, maxX: 2, minY: -2, maxY: 2 },
+    obstacles: [...componentPads, bottomPad],
+    connections: [{
+      name: "SIGNAL",
+      pointsToConnect: [
+        { x: 0, y: 0, layer: "top", pcb_port_id: "source-port" },
+        { x: 2, y: 1.2, layer: "bottom", pointId: "boundary-port" },
+      ],
+    }],
+  }
+  const [bus] = prepareFanoutBuses(input, {
+    sharedBoundary: input.bounds,
+    sourceComponentId: "source-grid",
+    buses: [{
+      busId: "signal-boundary",
+      connectionNames: ["SIGNAL"],
+      sourceComponentId: "source-grid",
+      exitEdge: "right",
+      preferredExit: "right",
+      allowedLayers: ["top", "bottom"],
+      connectionExitTargets: { SIGNAL: { x: 2, y: 1.2, layer: "bottom" } },
+    }],
+  })
+  if (!bus) throw new Error("Fixture did not prepare its source grid")
+  return { input, bus, bottomPad }
+}
