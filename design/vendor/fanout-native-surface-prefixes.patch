diff --git a/tests/fresh-source-corner-normalization.test.ts b/tests/fresh-source-corner-normalization.test.ts
new file mode 100644
index 0000000..5d340d2
--- /dev/null
+++ b/tests/fresh-source-corner-normalization.test.ts
@@ -0,0 +1,50 @@
+import { expect, test } from "bun:test"
+import type { SimpleRouteJson } from "@tscircuit/capacity-autorouter"
+import { getSvgFromGraphicsObject } from "graphics-debug"
+import { normalizeFreshSourceCorners } from "../lib/normalize-fresh-source-corners"
+import type { FanoutRoutePlan, FanoutRoutePoint } from "../lib/types"
+
+test("fresh surface prefixes remove numerical via-start duplicates and chamfer corners with native copper held hard", () => {
+  const source = { x: 0, y: 0, layer: "top", pcb_port_id: "native-source-port" }, exit = { x: 2, y: 2 }, target = { x: 4, y: 4, layer: "bottom" }
+  const pad = { type: "rect" as const, center: source, width: .4, height: .4, layers: ["top"], connectedTo: ["DATA", source.pcb_port_id] }
+  const layers = ["top", "inner1", "inner2", "bottom"]
+  const route: FanoutRoutePoint[] = [
+    { route_type: "wire", ...source, width: .1, start_pcb_port_id: source.pcb_port_id },
+    { route_type: "wire", x: .4, y: .4, layer: "top", width: .1 },
+    { route_type: "via", x: .4, y: .4, from_layer: "top", to_layer: "bottom", layers, via_diameter: .3, via_hole_diameter: .15 },
+    ...[{ x: .4, y: .4 }, { x: .4 + 1e-15, y: .4 + 1e-15 }, { x: .9, y: .9 }, { x: 1.5, y: .9 }, { x: 1.5, y: 1.5 }, exit].map(point => ({ ...point, route_type: "wire" as const, layer: "bottom", width: .1 })),
+  ]
+  const segments = route.slice(1).flatMap((point, index) => {
+    const previous = route[index]!
+    return point.route_type === "wire" && previous.route_type === "wire" && point.layer === previous.layer ? [{ start: { x: previous.x, y: previous.y }, end: { x: point.x, y: point.y }, width: .1, layer: point.layer }] : []
+  })
+  const input: SimpleRouteJson = { layerCount: 4, minTraceWidth: .1, bounds: { minX: -1, maxX: 2, minY: -1, maxY: 2 }, connections: [{ name: "DATA", pointsToConnect: [source, target] }], obstacles: [pad,
+    ...["inner1", "inner2"].map(layer => ({ type: "rect" as const, center: { x: .5, y: .5 }, width: 3, height: 3, layers: [layer], isCopperPour: true, connectedTo: ["GND"] })),
+    { type: "rect", center: { x: -.7, y: 1.4 }, width: .3, height: .3, layers, connectedTo: ["native-npth"] },
+  ], traces: [{ type: "pcb_trace", pcb_trace_id: "native-fixed-foreign", connection_name: "FIXED", route: [{ route_type: "wire", x: -.7, y: -.7, width: .1, layer: "bottom" }, { route_type: "wire", x: .7, y: -.7, width: .1, layer: "bottom" }] }] }
+  const plan: FanoutRoutePlan = { busId: "data", connectionName: "DATA", connectionIndex: 0, sourcePointIndex: 0, sourcePoint: source, sourceObstacle: pad, sourceLayer: "top", targetPoint: target, targetLayer: "bottom", termination: { type: "boundary" }, direction: "up", exitPoint: exit, segments, length: 4, via: { center: { x: .4, y: .4 }, diameter: .3, holeDiameter: .15, fromLayer: "top", toLayer: "bottom", spanLayers: layers }, trace: { type: "pcb_trace", pcb_trace_id: "fresh-data-prefix", connection_name: "DATA", route } }
+  const original = JSON.stringify({ input, plan }), normalized = normalizeFreshSourceCorners({ inputSrj: input, plans: [plan], clearance: .1 })
+  expect(normalized).toHaveLength(1)
+  const result = normalized![0]!
+  expect(result.trace.route).toHaveLength(route.length)
+  expect(result.trace.route[0]).toEqual(route[0])
+  expect(result.trace.route.at(-1)).toEqual(route.at(-1))
+  expect(result.trace.route.filter(point => point.route_type === "via")).toEqual(route.filter(point => point.route_type === "via"))
+  expect(result.via).toEqual(plan.via)
+  expect(result.sourcePoint).toEqual(source)
+  expect(result.targetPoint).toEqual(target)
+  expect(result.trace.route.some(point => point.x === 1.45 && point.y === .9)).toBe(true)
+  expect(result.trace.route.some(point => Math.abs(point.x - 1.5) < 1e-9 && Math.abs(point.y - .95) < 1e-9)).toBe(true)
+  expect(result.segments.every(segment => segment.width === .1 && ["top", "bottom"].includes(segment.layer))).toBe(true)
+  expect(JSON.stringify({ input, plan })).toBe(original)
+  expect(normalizeFreshSourceCorners({ inputSrj: input, plans: [plan], clearance: .1, immutableTraceIds: new Set([plan.trace.pcb_trace_id]) })).toBeNull()
+  expect(normalizeFreshSourceCorners({ inputSrj: input, plans: [result], clearance: .1, immutableTraceIds: new Set([result.trace.pcb_trace_id]) })?.[0]!.trace).toEqual(result.trace)
+  const supplied = { ...input, traces: [...input.traces!, result.trace] }
+  expect(normalizeFreshSourceCorners({ inputSrj: supplied, plans: [result], clearance: .1 })?.[0]!.trace).toEqual(result.trace)
+  expect(normalizeFreshSourceCorners({ inputSrj: { ...input, traces: [...input.traces!, plan.trace] }, plans: [result], clearance: .1 })).toBeNull()
+  const foreign = { ...input, obstacles: [...input.obstacles, { type: "rect" as const, center: { x: 1.475, y: .925 }, width: .02, height: .02, layers: ["bottom"], connectedTo: ["FOREIGN"] }] }
+  expect(normalizeFreshSourceCorners({ inputSrj: foreign, plans: [plan], clearance: .1 })).toBeNull()
+  const anchored = { ...plan, sourceEscapeSegmentCount: 4 }
+  expect(normalizeFreshSourceCorners({ inputSrj: input, plans: [anchored], clearance: .1 })).toBeNull()
+  expect(getSvgFromGraphicsObject({ title: "Fresh native surface copper: exact source and barrel, numerical cleanup and 45-degree chamfer", lines: result.segments.map(segment => ({ points: [segment.start, segment.end], strokeColor: segment.layer === "top" ? "#2563eb" : "#15803d", strokeWidth: segment.width })), circles: [{ center: plan.via!.center, radius: .15, fill: "#bbf7d0", stroke: "#15803d" }, { center: plan.via!.center, radius: .075, fill: "white", stroke: "#334155" }], points: [{ ...source, label: "native source" }, { ...exit, label: "exact boundary" }] })).toMatchSnapshot()
+})
diff --git a/tests/fresh-source-fold-normalization.test.ts b/tests/fresh-source-fold-normalization.test.ts
