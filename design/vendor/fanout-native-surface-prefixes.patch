+import { test, expect } from "bun:test"
+import type { Obstacle } from "@tscircuit/capacity-autorouter"
+import { getSvgFromGraphicsObject } from "graphics-debug"
+import { createNativeLayerDogboneFixture } from "./fixtures/native-layer-dogbone"
+import { prepareFanoutBuses } from "../lib/prepare-buses"
+import { routeMixedSurfaceSourcePrefixesSteps } from "../lib/route-mixed-surface-source-prefixes"
+import { validateRoutedCopperDrc } from "../lib/validate-routed-copper-drc"
+import { buildOutputSimpleRouteJson, validateFanoutSolution } from "../lib"
+test("a cold mixed source solve derives a conventional Bottom escape from an enclosed Top source", () => {
+  const { input } = createNativeLayerDogboneFixture()
+  const ring: Obstacle[] = [
+    { type: "rect", center: { x: 0, y: 1.2 }, width: 2.6, height: .2, layers: ["top"], connectedTo: ["foreign"] },
+    { type: "rect", center: { x: 0, y: -1.2 }, width: 2.6, height: .2, layers: ["top"], connectedTo: ["foreign"] },
+    { type: "rect", center: { x: 1.2, y: 0 }, width: .2, height: 2.6, layers: ["top"], connectedTo: ["foreign"] },
+    { type: "rect", center: { x: -1.2, y: 0 }, width: .2, height: 2.6, layers: ["top"], connectedTo: ["foreign"] },
+  ]
+  input.obstacles.push(...ring, ...["inner1", "inner2"].map(layer => ({ type: "rect" as const, center: { x: 0, y: 0 }, width: 4, height: 4, layers: [layer], isCopperPour: true, connectedTo: ["GND"] })))
+  const buses = prepareFanoutBuses(input, { sharedBoundary: input.bounds, sourceComponentId: "source-grid", buses: [{ busId: "signal", connectionNames: ["SIGNAL"], sourceComponentId: "source-grid", allowedLayers: ["top", "bottom"] }] })
+  const original = JSON.stringify(input)
+  const params = { srj: input, buses, traceWidth: .1, clearance: .1, viaDiameter: .3, viaHoleDiameter: .15, gridStep: .1 }
+  const work = routeMixedSurfaceSourcePrefixesSteps(params)
+  let next = work.next()
+  while (!next.done)
+    next = work.next()
+  const plans = next.value
+  expect(plans).toHaveLength(1)
+  if (!plans)
+    throw Error("The native source must receive one complete prefix")
+  expect(plans[0]!.targetLayer).toBe("bottom")
+  expect(plans[0]!.sourcePoint).toEqual(input.connections[0]!.pointsToConnect[0])
+  expect(plans[0]!.via).toMatchObject({ diameter: .3, holeDiameter: .15, spanLayers: ["top", "inner1", "inner2", "bottom"] })
+  expect(plans[0]!.trace.route.filter(point => point.route_type === "wire").every(point => point.layer === "top" || point.layer === "bottom")).toBe(true)
+  expect(validateRoutedCopperDrc({ inputSrj: input, routedSrj: { ...input, traces: plans.map(plan => plan.trace) }, clearance: .1, allowBlindAndBuriedVias: false })).toMatchObject({ valid: true, issues: [] })
+  expect(plans[0]!.busId).toBe(buses[0]!.busId)
+  expect(validateFanoutSolution({inputSrj:input,outputSrj:buildOutputSimpleRouteJson({inputSrj:input,plans,layerNames:["top","inner1","inner2","bottom"]}),plans,preparedBuses:buses,sharedBoundary:input.bounds,clearance:.1,allowBlindAndBuriedVias:false})).toMatchObject({valid:true,issues:[]})
+  expect(JSON.stringify(input)).toBe(original)
+  const fractionalGrid = routeMixedSurfaceSourcePrefixesSteps({ ...params, gridStep: .11 })
+  let fractional = fractionalGrid.next()
+  while (!fractional.done) fractional = fractionalGrid.next()
+  expect(fractional.value).toHaveLength(1)
+  const fractionalPlan = fractional.value![0]!
+  expect([Math.abs(fractionalPlan.exitPoint.x - input.bounds.minX), Math.abs(fractionalPlan.exitPoint.x - input.bounds.maxX), Math.abs(fractionalPlan.exitPoint.y - input.bounds.minY), Math.abs(fractionalPlan.exitPoint.y - input.bounds.maxY)].some(distance => distance < 1e-7)).toBe(true)
+  expect(validateFanoutSolution({ inputSrj: input, outputSrj: buildOutputSimpleRouteJson({ inputSrj: input, plans: fractional.value!, layerNames: ["top", "inner1", "inner2", "bottom"] }), plans: fractional.value!, preparedBuses: buses, sharedBoundary: input.bounds, clearance: .1, allowBlindAndBuriedVias: false })).toMatchObject({ valid: true, issues: [] })
+  expect(() => routeMixedSurfaceSourcePrefixesSteps({ ...params, buses: [buses[0]!, { ...buses[0]!, busId: "duplicate-source" }] }).next()).toThrow("unique bus and connection")
+  expect(() => routeMixedSurfaceSourcePrefixesSteps({ ...params, maximumWindingAttempts: 0 }).next()).toThrow("positive safe integer")
+  expect(() => routeMixedSurfaceSourcePrefixesSteps({ ...params, maximumWindingSearchStates: Number.NaN }).next()).toThrow("positive safe integer")
+  const blocked = { ...input, obstacles: [...input.obstacles, { type: "rect" as const, center: { x: 0, y: 0 }, width: 4, height: 4, layers: ["bottom"], connectedTo: ["foreign-bottom"] }] }
+  const failed = routeMixedSurfaceSourcePrefixesSteps({ ...params, srj: blocked })
+  let failure = failed.next()
+  while (!failure.done)
+    failure = failed.next()
+  expect(failure.value).toBeNull()
+  expect(getSvgFromGraphicsObject({ title: "Actual four-layer source: Top enclosure, conventional via, Bottom egress", rects: ring.map(obstacle => ({ center: obstacle.center, width: obstacle.width, height: obstacle.height, fill: "#94a3b8" })), lines: plans.flatMap(plan => plan.segments.map(segment => ({ points: [segment.start, segment.end], strokeWidth: segment.width, strokeColor: segment.layer === "top" ? "#2563eb" : "#15803d" }))), circles: plans.flatMap(plan => plan.via ? [{ center: plan.via.center, radius: plan.via.diameter / 2, strokeColor: "#15803d", strokeWidth: .02 }] : []) })).toMatchSnapshot()
+})
