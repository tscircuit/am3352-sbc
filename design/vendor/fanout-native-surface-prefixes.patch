+import { test, expect } from "bun:test"
+import type { Obstacle } from "@tscircuit/capacity-autorouter"
+import { getSvgFromGraphicsObject } from "graphics-debug"
+import { createNativeLayerDogboneFixture } from "./fixtures/native-layer-dogbone"
+import { prepareFanoutBuses } from "../lib/prepare-buses"
+import { routeMixedSurfaceSourcePrefixesSteps } from "../lib/route-mixed-surface-source-prefixes"
+import { validateRoutedCopperDrc } from "../lib/validate-routed-copper-drc"
+test("a provisional Bottom site is revised to preserve a required Top corridor", () => {
+  const { input } = createNativeLayerDogboneFixture()
+  const sourcePad = input.obstacles.find(obstacle => obstacle.center.x === 0 && obstacle.center.y === .8)!
+  sourcePad.connectedTo = ["TOP_REQUIRED", "required-source-port"]
+  sourcePad.circuitJsonMetadata = { pcb_port_id: "required-source-port" }
+  input.connections.push({ name: "TOP_REQUIRED", pointsToConnect: [{ x: 0, y: .8, layer: "top", pcb_port_id: "required-source-port" }, { x: 2, y: 0, layer: "top", pointId: "required-target-port" }] })
+  const ring: Obstacle[] = [
+    { type: "rect", center: { x: 0, y: 1.2 }, width: 2.6, height: .2, layers: ["top"], connectedTo: ["foreign"] },
+    { type: "rect", center: { x: 0, y: -1.2 }, width: 2.6, height: .2, layers: ["top"], connectedTo: ["foreign"] },
+    { type: "rect", center: { x: -1.2, y: 0 }, width: .2, height: 2.6, layers: ["top"], connectedTo: ["foreign"] },
+    { type: "rect", center: { x: 1.2, y: .925 }, width: .2, height: .75, layers: ["top"], connectedTo: ["foreign"] },
+    { type: "rect", center: { x: 1.2, y: -.525 }, width: .2, height: 1.55, layers: ["top"], connectedTo: ["foreign"] },
+  ]
+  input.obstacles.push(...ring, { type: "rect", center: { x: -.4, y: .4 }, width: .1, height: .1, layers: ["bottom"], connectedTo: ["foreign-site-blocker"] }, { type: "rect", center: { x: -.4, y: -.4 }, width: .1, height: .1, layers: ["bottom"], connectedTo: ["foreign-lower-site-blocker"] }, ...["inner1", "inner2"].map(layer => ({ type: "rect" as const, center: { x: 0, y: 0 }, width: 4, height: 4, layers: [layer], isCopperPour: true, connectedTo: ["GND"] })))
+  const buses = prepareFanoutBuses(input, { sharedBoundary: input.bounds, sourceComponentId: "source-grid", buses: input.connections.map(connection => ({ busId: connection.name, connectionNames: [connection.name], sourceComponentId: "source-grid", allowedLayers: connection.name === "SIGNAL" ? ["bottom"] : ["top"] })) })
+  const original = JSON.stringify(input), alternatives: number[] = []
+  const limited = routeMixedSurfaceSourcePrefixesSteps({ srj: input, buses, traceWidth: .1, clearance: .1, viaDiameter: .3, viaHoleDiameter: .15, gridStep: .1, maximumSiteAlternatives: 0, criticalSourceCorridors: false })
+  let limitedNext = limited.next()
+  while (!limitedNext.done)
+    limitedNext = limited.next()
+  expect(limitedNext.value).toBeNull()
+  const work = routeMixedSurfaceSourcePrefixesSteps({ srj: input, buses, traceWidth: .1, clearance: .1, viaDiameter: .3, viaHoleDiameter: .15, gridStep: .1, onProgress: progress => { if (progress.phase === "source-site-alternative")
+      alternatives.push(progress.sourceCount); } })
+  let next = work.next()
+  while (!next.done)
+    next = work.next()
+  const plans = next.value
+  expect(plans).toHaveLength(2)
+  expect(alternatives.length).toBeGreaterThan(0)
+  if (!plans)
+    throw Error("Both original sources must receive complete, mutually clear prefixes")
+  expect(plans.find(plan => plan.connectionName === "TOP_REQUIRED")?.targetLayer).toBe("top")
+  expect(plans.find(plan => plan.connectionName === "SIGNAL")?.targetLayer).toBe("bottom")
+  expect(validateRoutedCopperDrc({ inputSrj: input, routedSrj: { ...input, traces: plans.map(plan => plan.trace) }, clearance: .1, allowBlindAndBuriedVias: false })).toMatchObject({ valid: true, issues: [] })
+  expect(JSON.stringify(input)).toBe(original)
+  expect(getSvgFromGraphicsObject({ title: "A native-domain via revision keeps the required Top corridor open", rects: ring.map(obstacle => ({ center: obstacle.center, width: obstacle.width, height: obstacle.height, fill: "#94a3b8" })), lines: plans.flatMap(plan => plan.segments.map(segment => ({ points: [segment.start, segment.end], strokeWidth: segment.width, strokeColor: segment.layer === "top" ? "#2563eb" : "#15803d" }))), points: plans.map(plan => ({ ...plan.sourcePoint, label: plan.connectionName })) })).toMatchSnapshot()
+})
diff --git a/tests/mixed-surface-source-prefixes.test.ts b/tests/mixed-surface-source-prefixes.test.ts
