+++ b/tests/copper-pour-through-via-reservation.test.ts
@@ -0,0 +1,48 @@
+import { expect, test } from "bun:test"
+import { getSvgFromGraphicsObject, type GraphicsObject } from "graphics-debug"
+import { getCopperLayerNames } from "../lib/layer-names"
+import { getComponentDogboneViaSiteCandidates } from "../lib/match-component-dogbone-via-sites"
+import { fanoutPlansAreClear, routeBusAlternativesSteps } from "../lib/route-bus"
+import { validateRoutedCopperDrc } from "../lib/validate-routed-copper-drc"
+import { createNativeLayerDogboneFixture } from "./fixtures/native-layer-dogbone"
+import { buildOutputSimpleRouteJson, validateFanoutSolution } from "../lib"
+
+test("inner ground sheets reserve wires while physical through-vias form antipads", () => {
+  const { input, bus } = createNativeLayerDogboneFixture()
+  const grounds = ["inner1", "inner2"].map((layer) => ({
+    type: "rect" as const,
+    obstacleId: `ground-${layer}`,
+    isCopperPour: true,
+    center: { x: 0, y: 0 },
+    width: 4,
+    height: 4,
+    layers: [layer],
+    connectedTo: ["GND"],
+  }))
+  input.obstacles.push(...grounds)
+  const original = JSON.stringify(input)
+  const point = { x: -0.4, y: 0.4 }
+  const rules = { viaDiameter: 0.3, viaHoleDiameter: 0.15, traceWidth: 0.1, clearance: 0.1, fixedViaPointsByConnectionIndex: new Map([[0, point]]) }
+  expect(getComponentDogboneViaSiteCandidates([bus], { ...rules, additionalObstacles: input.obstacles })).toEqual([{ connectionIndex: 0, point }])
+  const params = { srj: input, bus, targetLayer: "bottom", acceptedPlans: [], layerNames: getCopperLayerNames(4), ...rules, compactBusTracks: false, allowBlindAndBuriedVias: false, allowSameNetMerges: true, viaMinimalOnly: true }
+  const steps = routeBusAlternativesSteps(params, 1)
+  let result = steps.next()
+  while (!result.done) result = steps.next()
+  const [plans] = result.value
+  if (!plans) throw new Error("Physical native four-layer dogbone did not route")
+  expect(plans).toHaveLength(1)
+  const plan = plans[0]!
+  expect(plan.via?.spanLayers).toEqual(["top", "inner1", "inner2", "bottom"])
+  expect(plan.via?.diameter).toBe(0.3)
+  expect(plan.via?.holeDiameter).toBe(0.15)
+  expect(fanoutPlansAreClear({ plans, srj: input, sharedBoundary: bus.sharedBoundary, clearance: 0.1, allowBlindAndBuriedVias: false, allowSameNetMerges: true })).toBe(true)
+  expect(validateRoutedCopperDrc({ inputSrj: input, routedSrj: { ...input, traces: plans.map((candidate) => candidate.trace) }, clearance: 0.1, allowBlindAndBuriedVias: false })).toMatchObject({ valid: true, issues: [] })
+  expect(validateFanoutSolution({inputSrj:input,outputSrj:buildOutputSimpleRouteJson({inputSrj:input,plans,layerNames:getCopperLayerNames(4)}),plans,preparedBuses:[bus],sharedBoundary:bus.sharedBoundary,clearance:.1,allowBlindAndBuriedVias:false})).toMatchObject({valid:true,issues:[]})
+  const blockedTrace = { ...plan.trace, route: plan.trace.route.map((item) => item.route_type === "wire" && item.layer === "bottom" ? { ...item, layer: "inner1" } : item.route_type === "via" ? { ...item, to_layer: "inner1" } : item) }
+  const rejected = validateRoutedCopperDrc({ inputSrj: input, routedSrj: { ...input, traces: [blockedTrace] }, clearance: 0.1, allowBlindAndBuriedVias: false })
+  expect(rejected.valid).toBe(false)
+  expect(rejected.issues.some((issue) => issue.code === "trace-obstacle-clearance" && issue.obstacleId === "ground-inner1")).toBe(true)
+  expect(JSON.stringify(input)).toBe(original)
+  const graphics: GraphicsObject = { lines: plan.segments.map((segment) => ({ points: [segment.start, segment.end], strokeColor: segment.layer === "top" ? "#2563eb" : "#dc2626", strokeWidth: segment.width })), circles: [{ center: point, radius: 0.15, fill: "#059669" }], texts: [{ x: 0, y: 1.7, text: "TOP → full-stack through-via → BOTTOM; inner GND intact", fontSize: 0.1 }] }
+  expect(getSvgFromGraphicsObject(graphics)).toMatchSnapshot()
+})
