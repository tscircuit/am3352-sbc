@@ -0,0 +1,32 @@
+import { expect, test } from "bun:test"
+import { getSvgFromGraphicsObject, type GraphicsObject } from "graphics-debug"
+import { distancePointToObstacle, distanceSegmentToObstacle } from "../lib/geometry"
+import { getComponentDogboneViaSiteCandidates } from "../lib/match-component-dogbone-via-sites"
+import { createNativeLayerDogboneFixture } from "./fixtures/native-layer-dogbone"
+
+test("a top dogbone ignores bottom wire overlap while its full-span via clears every pad", () => {
+  const { input, bus, bottomPad } = createNativeLayerDogboneFixture()
+  const original = JSON.stringify(input)
+  const point = { x: -0.4, y: 0.4 }
+  const segment = { start: { x: 0, y: 0 }, end: point, layer: "top", width: 0.1 }
+  const rules = {
+    viaDiameter: 0.3,
+    viaHoleDiameter: 0.15,
+    traceWidth: 0.1,
+    clearance: 0.1,
+    fixedViaPointsByConnectionIndex: new Map([[0, point]]),
+  }
+  expect(distanceSegmentToObstacle(segment, bottomPad)).toBeLessThan(0.15)
+  expect(distancePointToObstacle(point, bottomPad) - 0.15).toBeGreaterThan(0.4)
+  expect(getComponentDogboneViaSiteCandidates([bus], { ...rules, additionalObstacles: input.obstacles })).toEqual([{ connectionIndex: 0, point }])
+  expect(getComponentDogboneViaSiteCandidates([bus], { ...rules, additionalObstacles: [...input.obstacles.filter((obstacle) => obstacle !== bottomPad), { ...bottomPad, layers: ["top"] }] })).toEqual([])
+  expect(getComponentDogboneViaSiteCandidates([bus], { ...rules, additionalObstacles: [...input.obstacles, { ...bottomPad, center: point, width: 0.2, height: 0.2 }] })).toEqual([])
+  expect(JSON.stringify(input)).toBe(original)
+  const graphics: GraphicsObject = {
+    lines: [{ points: [segment.start, segment.end], strokeColor: "#2563eb", strokeWidth: segment.width }],
+    circles: [{ center: segment.start, radius: 0.2, fill: "#93c5fd" }, { center: point, radius: 0.15, fill: "#2563eb" }],
+    rects: [{ center: bottomPad.center, width: bottomPad.width, height: bottomPad.height, fill: "#fca5a5" }],
+    texts: [{ x: 0, y: 0.8, text: "TOP wire crosses BOTTOM pad; via clears both", fontSize: 0.08 }],
+  }
+  expect(getSvgFromGraphicsObject(graphics)).toMatchSnapshot()
+})
diff --git a/tests/earlier-phase-native-owner-cohort.test.ts b/tests/earlier-phase-native-owner-cohort.test.ts
new file mode 100644
index 0000000..1a414e8
--- /dev/null
+++ b/tests/earlier-phase-native-owner-cohort.test.ts
@@ -0,0 +1,126 @@
+import { expect, test } from "bun:test"
+import type { Obstacle, SimpleRouteJson } from "@tscircuit/capacity-autorouter"
+import { getSvgFromGraphicsObject } from "graphics-debug"
+import { FanoutSolver, buildOutputSimpleRouteJson, routeMixedSurfaceSourcePrefixesSteps,
+  validateRoutedCopperDrc, type FanoutSimplifiedPcbTrace } from "../lib"
+
+function nativeFixture(): SimpleRouteJson {
+  const sourcePoints = [{ x: -.8, y: -.8 }, { x: .8, y: -.8 }, { x: 0, y: 0 }]
+  const pad = (center: { x: number; y: number }, owner: string, port: string, componentId: string): Obstacle => ({
+    type: "rect", center, width: .4, height: .4, layers: ["top"], connectedTo: [owner, port], componentId,
+    ...{ shape: "circle", circuitJsonMetadata: { pcb_port_id: port, pcb_smtpad_id: `pad-${port}` } },
+  })
+  const traces: FanoutSimplifiedPcbTrace[] = sourcePoints.slice(0, 2).map((source, index) => ({
+    type: "pcb_trace", pcb_trace_id: `earlier-trace-${index}`, connection_name: `earlier-owner-${index}`,
+    ...{ source_trace_id: `native-trace-${index}` }, route: [
+      { route_type: "wire", ...source, layer: "top", width: .1, start_pcb_port_id: `native-source-${index}` },
+      { route_type: "wire", x: index === 0 ? -6 : 6, y: source.y, layer: "top", width: .1,
+        end_pcb_port_id: `native-target-${index}` },
+    ],
+  }))
+  const input: SimpleRouteJson = {
+    layerCount: 4, minTraceWidth: .1, minViaDiameter: .3, defaultObstacleMargin: .1,
+    bounds: { minX: -10, maxX: 10, minY: -10, maxY: 10 }, traces,
+    connections: [{ name: "pending-owner", pointsToConnect: [
+      { x: 0, y: 0, layer: "top", pcb_port_id: "native-source-2" },
+      { x: 6, y: 0, layer: "top", pcb_port_id: "native-target-2" },
+    ] }],
+    obstacles: [
+      ...sourcePoints.flatMap((source, index) => [
+        pad(source, index < 2 ? `earlier-owner-${index}` : "pending-owner", `native-source-${index}`, "actual-processor"),
+        pad({ x: index === 0 ? -6 : 6, y: source.y }, index < 2 ? `earlier-owner-${index}` : "pending-owner",
+          `native-target-${index}`, `target-component-${index}`),
+      ]),
+      ...[-.8, 0, .8].flatMap(x => [-.8, 0, .8].filter(y => !sourcePoints.some(source => source.x === x && source.y === y))
+        .map(y => pad({ x, y }, `unconnected-native-${x}-${y}`, `unconnected-port-${x}-${y}`, "actual-processor"))),
+      ...["inner1", "inner2"].map(layer => ({ type: "rect" as const, center: { x: 0, y: 0 },
+        width: 20, height: 20, layers: [layer], isCopperPour: true, connectedTo: ["native-ground"] })),
+      ...[-9, 9].flatMap(x => [-9, 9].map(y => ({ type: "rect" as const, center: { x, y }, width: .6, height: .6,
+        layers: ["top", "inner1", "inner2", "bottom"], connectedTo: [], isNonPlatedHole: true, ...{ shape: "circle" } }))),
+    ],
+  }
+  // A remote pad can name only the original native connectivity key. Its
+  // equivalence is proved by the original source pad, not a fabricated alias.
+  input.obstacles[0]!.connectedTo.push("native-connectivity-0")
+  input.obstacles[1]!.connectedTo = ["native-connectivity-0", "native-target-0"]
+  traces[0]!.connectsTo = ["native-connectivity-0"]
+  return input
+}
+
+test("immutable earlier-phase native copper retains its owner outside the pending source cohort", () => {
+  const input = nativeFixture(), original = JSON.stringify(input)
+  const check = (routedSrj: SimpleRouteJson, inputSrj = input) => validateRoutedCopperDrc({ inputSrj, routedSrj,
+    clearance: .1, allowBlindAndBuriedVias: false })
+  expect(input.connections).toHaveLength(1)
+  expect(check(input)).toMatchObject({ valid: true, checkedTraceCount: 2, issues: [] })
+  const rules = { traceWidth: .1, clearance: .1, viaDiameter: .3, viaHoleDiameter: .15, gridStep: .1 }
+  const fanout = new FanoutSolver(input, { sourceComponentId: "actual-processor", ...rules,
+    escapeLayers: ["top", "bottom"], allowBlindAndBuriedVias: false,
+    buses: input.connections.map(connection => ({ busId: connection.name, connectionNames: [connection.name],
+      sourceComponentId: "actual-processor", allowedLayers: ["top", "bottom"] })) })
+  const work = routeMixedSurfaceSourcePrefixesSteps({ srj: input, buses: fanout.preparedBuses, ...rules,
+    criticalSourceCorridors: true })
+  let next = work.next()
+  while (!next.done) next = work.next()
+  expect(next.value).toHaveLength(1)
+  const plans = next.value!
+  expect(plans[0]!.targetLayer).toBe("top")
+  expect(plans[0]!.via).toBeUndefined()
+  expect(plans[0]!.segments.every(segment => segment.layer === "top" || segment.layer === "bottom")).toBe(true)
+  expect(plans[0]!.trace.route[0]).toMatchObject({ route_type: "wire", x: 0, y: 0,
+    layer: "top", start_pcb_port_id: "native-source-2" })
+  const output = buildOutputSimpleRouteJson({ inputSrj: input, plans,
+    layerNames: ["top", "inner1", "inner2", "bottom"] })
+  expect(JSON.stringify(output.traces!.slice(0, 2))).toBe(JSON.stringify(input.traces))
+  expect(output.connections[0]!.pointsToConnect[1]).toEqual(input.connections[0]!.pointsToConnect[1])
+  expect(check(output)).toMatchObject({ valid: true, issues: [] })
+  expect(JSON.stringify(input)).toBe(original)
+
+  const changed = structuredClone(output)
+  const priorPoint = changed.traces![0]!.route[0]!
+  if (priorPoint.route_type !== "wire") throw new Error("Expected the original native source wire")
+  priorPoint.x += .01
+  expect(check(changed).issues).toContainEqual(expect.objectContaining({ code: "unknown-trace-connection",
+    traceId: "earlier-trace-0" }))
+
+  const foreignPad = structuredClone(input)
+  foreignPad.obstacles.push({ type: "rect", center: { x: -3, y: -.8 }, width: .4, height: .4,
+    layers: ["top"], connectedTo: ["pending-owner"], obstacleId: "actual-foreign-pad" })
+  expect(check(foreignPad, foreignPad).issues).toContainEqual(expect.objectContaining({ code: "trace-obstacle-clearance",
+    traceId: "earlier-trace-0", obstacleId: "actual-foreign-pad" }))
+
+  const crossing = structuredClone(output)
+  crossing.traces!.push({ type: "pcb_trace", pcb_trace_id: "foreign-new-route", connection_name: "pending-owner", route: [
+    { route_type: "wire", x: -3, y: -1.3, layer: "top", width: .1 },
+    { route_type: "wire", x: -3, y: -.3, layer: "top", width: .1 },
+  ] })
+  expect(check(crossing).issues).toContainEqual(expect.objectContaining({ code: "different-net-trace-clearance",
+    traceId: "earlier-trace-0", otherTraceId: "foreign-new-route" }))
+
+  const contradictory = structuredClone(input)
+  contradictory.traces![0]!.connectsTo!.push("pending-owner")
+  expect(check(contradictory, contradictory).issues).toContainEqual(expect.objectContaining({
+    code: "unknown-trace-connection", traceId: "earlier-trace-0",
+    message: "Supplied trace earlier-trace-0 declares conflicting original native net owners",
+  }))
+  const conflictingId = structuredClone(input)
+  conflictingId.traces![0]!.pcb_trace_id = "pending-owner"
+  expect(check(conflictingId, conflictingId).issues).toContainEqual(expect.objectContaining({
+    code: "unknown-trace-connection", traceId: "pending-owner",
+  }))
+
+  expect(getSvgFromGraphicsObject({ title: "Immutable native Top owners; fresh Top escape from the pending source cohort",
+    lines: [
+      ...input.traces!.flatMap(trace => [{ points: trace.route.filter(point => point.route_type === "wire"),
+        strokeWidth: .1, strokeColor: "#2563eb" }]),
+      ...plans.flatMap(plan => plan.segments.map(segment => ({ points: [segment.start, segment.end],
+        strokeWidth: segment.width, strokeColor: "#15803d" }))),
+    ],
+    circles: input.obstacles.filter(obstacle => !obstacle.isCopperPour &&
+      !("isNonPlatedHole" in obstacle && obstacle.isNonPlatedHole === true)).map(obstacle => ({
+      center: obstacle.center, radius: obstacle.width / 2, fill: "#e2e8f0", stroke: "#64748b" })),
+    points: [{ x: -4.5, y: -.8, label: "immutable native owner 0" },
+      { x: 4.5, y: -.8, label: "immutable native owner 1" },
+      { ...plans[0]!.sourcePoint, label: "pending native source" }],
+  })).toMatchSnapshot()
+})
diff --git a/tests/expanded-conventional-dogbone-sites.test.ts b/tests/expanded-conventional-dogbone-sites.test.ts
new file mode 100644
index 0000000..deef583
--- /dev/null
+++ b/tests/expanded-conventional-dogbone-sites.test.ts
@@ -0,0 +1,96 @@
+import { expect, test } from "bun:test"
+import { getSvgFromGraphicsObject, type GraphicsObject } from "graphics-debug"
+import { distancePointToObstacle, distanceSegmentToObstacle } from "../lib/geometry"
+import { getCopperLayerNames } from "../lib/layer-names"
+import { getComponentDogboneViaSiteCandidates, matchComponentDogboneViaSites } from "../lib/match-component-dogbone-via-sites"
+import { fanoutPlansAreClear, routeBus } from "../lib/route-bus"
+import { validateRoutedCopperDrc } from "../lib/validate-routed-copper-drc"
+import { createNativeLayerDogboneFixture } from "./fixtures/native-layer-dogbone"
+
+test("expanded local sites keep old corners first and exclude owned-pad drills and all foreign copper", () => {
+  const { input, bus } = createNativeLayerDogboneFixture()
+  const sourcePad = bus.connections[0]!.sourceObstacle
+  const rules = { viaDiameter: 0.3, viaHoleDiameter: 0.15, traceWidth: 0.1, clearance: 0.1 }
+  const original = getComponentDogboneViaSiteCandidates([bus], { ...rules, additionalObstacles: input.obstacles })
+  const expanded = getComponentDogboneViaSiteCandidates([bus], { ...rules, additionalObstacles: input.obstacles, expandLocalSites: true })
+  expect(expanded.slice(0, original.length)).toEqual(original)
+  const blockers = [-0.4, 0.4].flatMap((x) => [-0.4, 0.4].map((y) => ({
+    type: "rect" as const,
+    shape: "circle" as const,
+    obstacleId: `fixed-bottom-pad-${x}-${y}`,
+    center: { x, y },
+    width: 0.04,
+    height: 0.04,
+    layers: ["bottom"],
+    connectedTo: ["SUPPLY"],
+  })))
+  const obstacles = [...bus.componentObstacles, ...blockers]
+  const supplied = JSON.stringify(obstacles)
+  expect(getComponentDogboneViaSiteCandidates([bus], { ...rules, additionalObstacles: obstacles })).toEqual([])
+  const candidates = getComponentDogboneViaSiteCandidates([bus], { ...rules, additionalObstacles: obstacles, expandLocalSites: true })
+  expect(candidates.length).toBeGreaterThan(0)
+  expect(candidates.length).toBeLessThanOrEqual(72)
+  for (const candidate of candidates) {
+    const ownGap = distancePointToObstacle(candidate.point, sourcePad)
+    expect(ownGap).toBeGreaterThan(0.075)
+    for (const obstacle of obstacles) {
+      if (obstacle !== sourcePad) expect(distancePointToObstacle(candidate.point, obstacle)).toBeGreaterThanOrEqual(0.25 - 1e-9)
+      if (obstacle !== sourcePad && obstacle.layers.includes("top")) expect(distanceSegmentToObstacle({ start: sourcePad.center, end: candidate.point, width: 0.1, layer: "top" }, obstacle)).toBeGreaterThanOrEqual(0.15 - 1e-9)
+    }
+  }
+  expect(candidates.some((candidate) => distancePointToObstacle(candidate.point, sourcePad) < 0.25)).toBe(true)
+  const assignment = matchComponentDogboneViaSites([bus], { ...rules, additionalObstacles: obstacles, expandLocalSites: true })
+  expect(assignment?.size).toBe(1)
+  const selectedPoint = assignment?.get(0)
+  if (!assignment || !selectedPoint) throw new Error("The physical off-pad site must be assigned")
+  const scene = { ...input, obstacles }
+  const plans = routeBus({
+    srj: scene, bus, targetLayer: "bottom", acceptedPlans: [],
+    layerNames: getCopperLayerNames(4), ...rules,
+    compactBusTracks: false, allowBlindAndBuriedVias: false,
+    allowSameNetMerges: true, viaMinimalOnly: true,
+    fixedViaPointsByConnectionIndex: assignment,
+    sourceEscapePaths: new Map([[0, [bus.connections[0]!.sourcePoint, selectedPoint]]]),
+  })
+  expect(plans).toHaveLength(1)
+  if (!plans) throw new Error("The assigned off-pad site must emit a physical route")
+  expect(plans[0]!.via).toMatchObject({ center: selectedPoint, diameter: 0.3, holeDiameter: 0.15, spanLayers: ["top", "inner1", "inner2", "bottom"] })
+  expect(fanoutPlansAreClear({ plans, srj: scene, sharedBoundary: bus.sharedBoundary, clearance: 0.1, allowBlindAndBuriedVias: false, allowSameNetMerges: true })).toBe(true)
+  expect(validateRoutedCopperDrc({ inputSrj: scene, routedSrj: { ...scene, traces: plans.map((plan) => plan.trace) }, clearance: 0.1, allowBlindAndBuriedVias: false })).toMatchObject({ valid: true, issues: [] })
+  expect(getComponentDogboneViaSiteCandidates([bus], { ...rules, additionalObstacles: obstacles, expandLocalSites: true, sourcePadDrillClearance: 0.15 })).toEqual([])
+  const strictDrillSites = getComponentDogboneViaSiteCandidates([bus], { ...rules, expandLocalSites: true, sourcePadDrillClearance: 0.35 })
+  expect(strictDrillSites.every(candidate => distancePointToObstacle(candidate.point, sourcePad) >= 0.425 + 1e-9)).toBe(true)
+  expect(strictDrillSites).toEqual([])
+  expect(getComponentDogboneViaSiteCandidates([bus], { ...rules, sourcePadDrillClearance: 0.35 })).toEqual([])
+  expect(() => getComponentDogboneViaSiteCandidates([bus], { ...rules, viaHoleDiameter: undefined, sourcePadDrillClearance: 0.35 })).toThrow("requires viaHoleDiameter")
+  expect(() => getComponentDogboneViaSiteCandidates([bus], { ...rules, viaHoleDiameter: undefined, expandLocalSites: true })).toThrow("require viaHoleDiameter")
+  expect(() => getComponentDogboneViaSiteCandidates([bus], { ...rules, viaHoleDiameter: rules.viaDiameter, expandLocalSites: true })).toThrow("drill smaller than the via land")
+  expect(() => getComponentDogboneViaSiteCandidates([bus], { ...rules, expandLocalSites: true, sourcePadDrillClearance: Number.NaN })).toThrow("non-negative finite")
+  expect(getComponentDogboneViaSiteCandidates([bus], { ...rules, additionalObstacles: [...obstacles, { ...sourcePad }], expandLocalSites: true })).toEqual([])
+  const nativeHole = { ...sourcePad, isNonPlatedHole: true }
+  const holeBus = { ...bus, componentObstacles: bus.componentObstacles.map((obstacle) => obstacle === sourcePad ? nativeHole : obstacle), connections: bus.connections.map((connection) => ({ ...connection, sourceObstacle: nativeHole })) }
+  expect(getComponentDogboneViaSiteCandidates([holeBus], { ...rules, additionalObstacles: obstacles.filter((obstacle) => obstacle !== sourcePad), expandLocalSites: true })).toEqual([])
+  expect(JSON.stringify(obstacles)).toBe(supplied)
+  const selected = candidates[0]!
+  const graphics: GraphicsObject = {
+    title: "Conventional off-pad site: drill outside its exact owning pad",
+    circles: [
+      ...bus.componentObstacles.map((obstacle) => ({
+        center: obstacle.center,
+        radius: obstacle.width / 2,
+        fill: obstacle === sourcePad ? "#f59e0b" : "#94a3b8",
+        label: obstacle === sourcePad ? "owning TOP pad" : "foreign TOP pad",
+      })),
+      ...blockers.map((obstacle) => ({
+        center: obstacle.center,
+        radius: obstacle.width / 2,
+        fill: "#dc2626",
+        label: "foreign BOTTOM copper blocks old corner",
+      })),
+      { center: selected.point, radius: rules.viaDiameter / 2, fill: "#22c55e", label: "full-stack manufactured via land" },
+      { center: selected.point, radius: rules.viaHoleDiameter / 2, fill: "#ffffff", label: "drill is outside owning pad" },
+    ],
+    lines: [{ points: [sourcePad.center, selected.point], strokeColor: "#15803d", strokeWidth: rules.traceWidth }],
+  }
+  expect(getSvgFromGraphicsObject(graphics)).toMatchSnapshot()
+})
