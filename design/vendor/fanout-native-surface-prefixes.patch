@@ -0,0 +1,30 @@
+import { expect, test } from "bun:test"
+import { getSvgFromGraphicsObject } from "graphics-debug"
+import type { SimpleRouteJson, SimplifiedPcbTrace } from "@tscircuit/capacity-autorouter"
+import { validateRoutedCopperDrc } from "../lib/validate-routed-copper-drc"
+
+test("unchanged earlier-phase copper remains a hard obstacle without a current-phase connection", () => {
+  const line = (name: string, y: number): SimplifiedPcbTrace => ({ type: "pcb_trace", pcb_trace_id: name, connection_name: name,
+    route: [{ route_type: "wire", x: -1, y, layer: "top", width: .1 }, { route_type: "wire", x: 1, y, layer: "top", width: .1 }] })
+  const fixed = line("EARLIER_PHASE", .5), signal = line("SIGNAL", -.5)
+  const input: SimpleRouteJson = { layerCount: 4, minTraceWidth: .1,
+    bounds: { minX: -2, maxX: 2, minY: -2, maxY: 2 },
+    obstacles: ["inner1", "inner2"].map(layer => ({ type: "rect", center: { x: 0, y: 0 }, width: 4, height: 4,
+      layers: [layer], isCopperPour: true, connectedTo: ["GND"] })),
+    traces: [fixed], connections: [{ name: "SIGNAL", pointsToConnect: [{ x: -1, y: -.5, layer: "top" }, { x: 1, y: -.5, layer: "top" }] }],
+  }
+  const original = JSON.stringify(input)
+  const check = (traces: SimplifiedPcbTrace[]) => validateRoutedCopperDrc({ inputSrj: input, routedSrj: { ...input, traces }, clearance: .1, allowBlindAndBuriedVias: false })
+  expect(check([structuredClone(fixed), signal])).toMatchObject({ valid: true, issues: [] })
+  const changed = structuredClone(fixed)
+  changed.route[0] = { route_type: "wire", x: -.9, y: .5, layer: "top", width: .1 }
+  expect(check([changed, signal]).issues).toEqual(expect.arrayContaining([expect.objectContaining({ code: "unknown-trace-connection", traceId: fixed.pcb_trace_id })]))
+  expect(check([{ ...changed, connection_name: "SIGNAL" }, signal]).valid).toBe(false)
+  const collision = check([fixed, line("SIGNAL", .4)])
+  expect(collision.valid).toBe(false)
+  expect(collision.issues.some(issue => issue.code === "different-net-trace-clearance")).toBe(true)
+  expect(JSON.stringify(input)).toBe(original)
+  expect(getSvgFromGraphicsObject({ title: "Earlier phase remains fixed copper outside current connection membership",
+    lines: [{ points: [{ x: -1, y: .5 }, { x: 1, y: .5 }], strokeColor: "#2563eb", strokeWidth: .1 },
+      { points: [{ x: -1, y: -.5 }, { x: 1, y: -.5 }], strokeColor: "#15803d", strokeWidth: .1 }] })).toMatchSnapshot()
+})
