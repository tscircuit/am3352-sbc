{
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@tscircuit/checks": "0.0.240",
    "@tscircuit/circuit-json-util": "0.0.119",
    "@tscircuit/core": "0.0.2095",
    "@tscircuit/fanout-solver": "file:design/vendor/tscircuit-fanout-solver-0.0.79-e3d476e.tgz",
    "@tscircuit/props": "0.0.689",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "circuit-json": "0.0.516",
    "circuit-json-to-connectivity-map": "0.0.33",
    "circuit-to-svg": "0.0.438",
    "react": "19.2.4",
    "three": "0.179.1",
    "tscircuit": "0.0.2745",
    "typescript": "5.9.3",
    "@tscircuit/capacity-autorouter": "file:design/vendor/tscircuit-capacity-autorouter-0.0.958-fa89cd01-f5348585.tgz"
  },
  "name": "@tsci/tscircuit.am3552-sbc",
  "version": "0.1.19",
  "private": true,
  "type": "module",
  "scripts": {
    "build:ddr": "bun scripts/build.tsx",
    "build:placement": "bun scripts/build-board.tsx --placement",
    "build:checkpoint": "bun scripts/build-board.tsx --ddr-only",
    "build": "bun scripts/build-board.tsx",
    "audit:ddr": "bun scripts/audit-ddr.ts",
    "check:ddr-signoff": "bun scripts/audit-ddr.ts --strict",
    "typecheck": "tsc --noEmit",
    "audit:checkpoint": "bun scripts/audit-checkpoint.ts",
    "build:power": "bun scripts/build-board.tsx --power-only",
    "generate:power": "python3 scripts/route-power-escapes.py",
    "audit:power": "bun scripts/audit-power.ts",
    "build:site": "tsci build --site",
    "build:portable-site": "bun scripts/portable-site.ts",
    "relocate:decouplers": "python3 scripts/relocate-decouplers.py",
    "generate:bridges": "python3 scripts/route-power-bridges.py",
    "audit:planes": "bun scripts/audit-power-planes.ts",
    "route:ddr-compliant": "bun scripts/check-solver-release.ts && bun scripts/export-ddr-input.tsx && bun scripts/route-compliant-ddr.ts",
    "test:ddr-constraints": "bun test tests/ddr-compliance.test.ts",
    "check:solver-release": "bun scripts/check-solver-release.ts",
    "route:ddr-outer": "bun scripts/check-ddr-vendor.ts && bun scripts/export-ddr-input.tsx && bun scripts/route-outer-ddr.ts --write-routes=design/ddr-routes.json",
    "audit:routed-board": "bun scripts/audit-routed-board.ts",
    "cache:routing": "bun scripts/cache-outer-routes.ts",
    "test:routing": "bun test tests",
    "dev": "tsci dev",
    "start": "tsci dev",
    "check:autorouter-vendor": "bun scripts/check-autorouter-vendor.ts",
    "check:fanout-vendor": "bun scripts/check-fanout-vendor.ts",
    "test:pcb": "bun test tests/pcb-snapshot.test.tsx",
    "snapshot:pcb": "BUN_UPDATE_SNAPSHOTS=1 bun test tests/pcb-snapshot.test.tsx",
    "snapshot:pcb-diff": "bun run test:pcb && bun scripts/render-pcb-comparison.ts"
  },
  "devDependencies": {
    "@tscircuit/bus-lanes-solver": "https://jscdn.tscircuit.com/@tscircuit/bus-lanes-solver/0.0.19.tgz",
    "@tscircuit/image-utils": "0.0.8",
    "bun-match-svg": "0.0.17",
    "circuit-json-to-pnp-csv": "0.0.18"
  }
}
