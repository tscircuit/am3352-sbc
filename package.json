{
  "name": "@tsci/astra.am3352-sbc",
  "version": "0.1.28",
  "type": "module",
  "scripts": {
    "dev": "tsci dev",
    "build": "bun --smol build.tsx",
    "build:site": "bun --smol build.tsx --site",
    "typecheck": "tsc --noEmit",
    "check:routing": "bun --smol check-routing.ts",
    "check:models": "bun --smol check-models.ts",
    "build:model-fixture": "bun --smol build-model-fixture.tsx",
    "check:models:fixture": "bun --smol check-models.ts .tscircuit/generated/models-only.circuit.json",
    "check:vias": "bun --smol check-vias.ts"
  },
  "dependencies": {
    "tscircuit": "0.0.2870",
    "@tscircuit/core": "0.0.2146",
    "@tscircuit/props": "0.0.702",
    "react": "^19.1.0",
    "schematic-symbols": "0.0.248",
    "@tscircuit/checks": "0.0.254",
    "circuit-json": "0.0.525",
    "circuit-json-to-connectivity-map": "0.0.33",
    "@tscircuit/bus-lanes-solver": "https://jscdn.tscircuit.com/@tscircuit/bus-lanes-solver/0.0.25.tgz"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/react": "^19.1.0",
    "@types/bun": "^1.3.0",
    "circuit-json-to-gltf": "0.0.151"
  }
}
