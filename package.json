{
  "name": "@tsci/astra.am3352-sbc",
  "version": "0.1.28",
  "type": "module",
  "scripts": {
    "dev": "tsci dev",
    "build": "tsci build index.circuit.tsx --disable-parts-engine --autorouter-timeout 14400s",
    "build:site": "tsci build index.circuit.tsx --disable-parts-engine --autorouter-timeout 14400s --site --use-cdn-javascript",
    "typecheck": "tsc --noEmit",
    "check:routing": "bun --smol check-routing.ts",
    "check:models": "bun --smol check-models.ts",
    "build:model-fixture": "bun --smol build-model-fixture.tsx",
    "check:models:fixture": "bun --smol check-models.ts .tscircuit/generated/models-only.circuit.json",
    "check:vias": "bun --smol check-vias.ts"
  },
  "dependencies": {
    "tscircuit": "0.0.3012",
    "@tscircuit/core": "file:./vendor/tscircuit-core-0.0.2203-am3352-consumed-graph.10.tgz",
    "@tscircuit/props": "0.0.709",
    "react": "^19.1.0",
    "schematic-symbols": "0.0.248",
    "@tscircuit/checks": "0.0.256",
    "circuit-json": "0.0.534",
    "circuit-json-to-connectivity-map": "0.0.33",
    "@tscircuit/bus-lanes-solver": "file:./vendor/tscircuit-bus-lanes-solver-0.0.34-am3352-terminal-via.1.tgz",
    "@tscircuit/fanout-solver": "file:./vendor/tscircuit-fanout-solver-0.0.81-am3352-compiled.5.tgz",
    "@tscircuit/cli": "file:./vendor/tscircuit-cli-0.1.2406-am3352-idle-polls.1.tgz",
    "@tscircuit/eval": "0.0.1657",
    "@tscircuit/runframe": "0.0.3060",
    "@tscircuit/capacity-autorouter": "file:./vendor/tscircuit-capacity-autorouter-0.0.1006-am3352-compact-streaming.15.tgz"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/react": "^19.1.0",
    "@types/bun": "^1.3.0",
    "circuit-json-to-gltf": "0.0.151",
    "tsx": "4.20.6"
  },
  "overrides": {
    "@tscircuit/core": "file:./vendor/tscircuit-core-0.0.2203-am3352-consumed-graph.10.tgz",
    "@tscircuit/capacity-autorouter": "file:./vendor/tscircuit-capacity-autorouter-0.0.1006-am3352-compact-streaming.15.tgz",
    "@tscircuit/bus-lanes-solver": "file:./vendor/tscircuit-bus-lanes-solver-0.0.34-am3352-terminal-via.1.tgz",
    "@tscircuit/fanout-solver": "$@tscircuit/fanout-solver",
    "@tscircuit/cli": "$@tscircuit/cli"
  }
}
